{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/achievements/?$",
			"dest": "_render"
		},
		{
			"src": "^/ai-assistant/?$",
			"dest": "_render"
		},
		{
			"src": "^/analytics/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio-builder/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolios/?$",
			"dest": "_render"
		},
		{
			"src": "^/preview/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}