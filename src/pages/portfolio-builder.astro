---
import Achievements from '../components/portfolio/Achievements.astro';
import BuilderProgress from '../components/portfolio/BuilderProgress.astro';
import Certifications from '../components/portfolio/Certifications.astro';
import Education from '../components/portfolio/Education.astro';
import Experience from '../components/portfolio/Experience.astro';
import GitHubImport from '../components/portfolio/GitHubImport.astro';
import LinkedInImport from '../components/portfolio/LinkedInImport.astro';
import PersonalInformation from '../components/portfolio/PersonalInformation.astro';
import PortfolioLayout from '../components/portfolio/PortfolioLayout.astro';
import Projects from '../components/portfolio/Projects.astro';
import ResumeUpload from '../components/portfolio/ResumeUpload.astro';
import SocialLinks from '../components/portfolio/SocialLinks.astro';
import Skills from '../components/portfolio/Skills.astro';
import WizardNavigation from '../components/portfolio/WizardNavigation.astro';
import WizardSidebar from '../components/portfolio/WizardSidebar.astro';
import { PenLine } from 'lucide-astro';
import { WIZARD_STEPS, wizardStore } from '../lib/portfolio';

const title = 'Portfolio Builder — PortForge AI';
const description = 'Create your professional portfolio with the PortForge AI guided builder.';

const activeStepId = wizardStore.getState().currentStep;
const isEdit = Boolean(new URL(Astro.url).searchParams.get('portfolio'));

const sectionsByStep = {
	personalInformation: PersonalInformation,
	education: Education,
	experience: Experience,
	projects: Projects,
	skills: Skills,
	certifications: Certifications,
	achievements: Achievements,
	socialLinks: SocialLinks,
	resume: ResumeUpload,
	githubImport: GitHubImport,
	linkedinImport: LinkedInImport,
};
---

<PortfolioLayout title={title} description={description}>
	<div class="flex w-full flex-col gap-lg">
		<header class="flex flex-col gap-md border-b border-hairline pb-lg">
			<div class="flex flex-col gap-xxs">
				<p class="text-eyebrow font-medium uppercase tracking-tight text-ink-subtle">
					{isEdit ? 'Edit Portfolio' : 'New Portfolio'}
				</p>
				<h1 class="text-headline text-ink">Build your professional portfolio</h1>
				<p class="max-w-narrow text-body-sm text-ink-subtle">{description}</p>
			</div>

			<div
				id="builder-edit-indicator"
				class="flex items-center gap-sm rounded-md border border-hairline bg-surface-2 px-md py-sm"
				role="status"
				hidden
			>
				<PenLine size="16" class="shrink-0 text-primary" aria-hidden="true" />
				<span class="text-body-sm font-medium text-ink">Editing Portfolio:</span>
				<span data-edit-title class="truncate text-body-sm font-medium text-ink-muted"></span>
			</div>
		</header>

		<BuilderProgress />

		<div class="grid grid-cols-1 gap-md lg:grid-cols-[15rem_1fr]">
			<WizardSidebar />

			<div class="flex min-w-0 flex-col">
				<div id="wizard-step-container">
					{
						WIZARD_STEPS.map((step) => {
							const SectionComponent = sectionsByStep[step.id];
							return (
								<div
									data-step-section-id={step.id}
									hidden={step.id !== activeStepId}
								>
									<SectionComponent />
								</div>
							);
						})
					}
				</div>

				<WizardNavigation />
			</div>
		</div>
	</div>
</PortfolioLayout>

<script>
	import { wizardStore } from '../lib/portfolio';
	import { addRepeatEntry, applySectionValues, collectSectionData, syncRepeatableRows } from '../lib/portfolio';
	import { scrollToActiveStep } from '../lib/portfolio';
	import type { PortfolioData } from '../lib/portfolio';
	import { portfolioManagerStore, portfolioOutputToData } from '../lib/portfolio-manager';
	import { themeStore, isThemeId } from '../lib/themes';

	const container = document.getElementById('wizard-step-container');

	const editParams = new URLSearchParams(window.location.search);
	const editPortfolioId = editParams.get('portfolio');
	const editRecord = editPortfolioId
		? portfolioManagerStore.getPortfolio(editPortfolioId)
		: undefined;

	if (editRecord) {
		wizardStore.reset();
		const editData = portfolioOutputToData(editRecord.data);
		for (const stepId of Object.keys(editData) as (keyof PortfolioData)[]) {
			wizardStore.setSectionData(stepId, editData[stepId]);
		}
		const templateId = editRecord.data.theme?.templateId ?? editRecord.data.metadata?.templateId;
		if (templateId && isThemeId(templateId)) {
			themeStore.setTheme(templateId);
		}
		const indicator = document.getElementById('builder-edit-indicator');
		if (indicator) {
			indicator.hidden = false;
			const titleEl = indicator.querySelector<HTMLElement>('[data-edit-title]');
			if (titleEl) titleEl.textContent = editRecord.title;
		}
	}

	/**
	 * Keeps repeatable-entry labels ("Education 2", "Project 3", …) accurate
	 * after the store-driven row sync clones templates. Each entry panel marks
	 * its label with `[data-entry-label]` and `data-entry-base`.
	 */
	const renumberEntryLabels = (section: HTMLElement): void => {
		for (const group of Array.from(section.querySelectorAll<HTMLElement>('[data-list-index]'))) {
			const label = group.querySelector<HTMLElement>('[data-entry-label]');
			if (!label) continue;
			const base = label.dataset.entryBase ?? '';
			label.textContent = base ? `${base} ${Number(group.dataset.listIndex) + 1}` : '';
		}
	};

	if (container) {
		const sections = Array.from(
			container.querySelectorAll<HTMLElement>('[data-step-section-id]')
		);

		for (const section of sections) {
			const stepId = section.dataset.stepSectionId as keyof PortfolioData | undefined;
			if (stepId) {
				syncRepeatableRows(section, stepId);
				applySectionValues(section, stepId);
				renumberEntryLabels(section);
			}
		}

		const persistTarget = (event: Event) => {
			const target = event.target as Element | null;
			const section = target?.closest<HTMLElement>('[data-step-section-id]');
			const stepId = section?.dataset.stepSectionId as keyof PortfolioData | undefined;
			if (!section || !stepId) return;

			const group = target?.closest<HTMLElement>('[data-list-index]');
			const index = group ? Number(group.dataset.listIndex) : 0;
			collectSectionData(group ?? section, stepId, index);
		};

		container.addEventListener('input', persistTarget);
		container.addEventListener('change', persistTarget);

		container.addEventListener('click', (event) => {
			const target = event.target as Element | null;
			const button = target?.closest<HTMLButtonElement>('[data-add-entry]');
			if (!button) return;
			const section = button.closest<HTMLElement>('[data-step-section-id]');
			const stepId = section?.dataset.stepSectionId as keyof PortfolioData | undefined;
			if (section && stepId) {
				addRepeatEntry(section, stepId);
				renumberEntryLabels(section);
			}
		});

		let lastStep = wizardStore.getState().currentStep;

		const applyState = () => {
			const { currentStep } = wizardStore.getState();
			const changed = currentStep !== lastStep;

			for (const section of sections) {
				section.hidden = section.dataset.stepSectionId !== currentStep;
				section.classList.toggle('animate-step-in', changed && !section.hidden);
			}

			if (changed) {
				lastStep = currentStep;
				scrollToActiveStep(container);
			}
		};

		wizardStore.subscribe(applyState);
		applyState();
	}
</script>
