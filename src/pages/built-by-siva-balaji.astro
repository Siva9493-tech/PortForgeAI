							aria-label="Send email to Siva Balaji"
						>
							<Mail size="16" class="text-ink-muted" aria-hidden="true" />
							<span>Email</span>
						</a>
					</div>
				</div>
			</div>
		</header>

		<!-- Divider line -->
		<hr class="border-t border-hairline mb-12 w-full" aria-hidden="true" />

		<!-- Section: About the Builder (Editorial Layout) -->
		<section class="reveal-item mb-14 w-full" style="--stagger-delay: 240ms;" aria-labelledby="about-builder-heading">
			<div class="mb-5 flex flex-col gap-1">
				<span class="text-caption font-semibold tracking-wider uppercase text-primary">
					Perspective & Background
				</span>
				<h2 id="about-builder-heading" class="text-2xl font-bold tracking-tight text-ink md:text-3xl">
					About the Builder
				</h2>
			</div>

