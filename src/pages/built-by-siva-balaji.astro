							linkedin.com/in/m-siva-balaji
						</span>
					</a>

					<!-- GitHub Card -->
					<a
						href="https://github.com/Siva9493-tech"
						target="_blank"
						rel="noopener noreferrer"
						id="connect-github-link"
						class="group flex w-full min-w-0 flex-col justify-between rounded-lg border border-hairline bg-surface-2 p-4 transition-colors duration-200 hover:border-hairline-strong focus-visible:outline-2"
						aria-label="View Siva Balaji's GitHub repositories (opens in new tab)"
					>
						<div class="flex items-center justify-between mb-3">
							<div class="flex items-center gap-2.5">
								<span class="flex h-8 w-8 items-center justify-center rounded-md bg-surface-3 text-ink-muted shrink-0" aria-hidden="true">
									<Github size="16" />
								</span>
								<span class="text-body-sm font-medium text-ink">GitHub</span>
							</div>
							<ExternalLink size="14" class="text-ink-tertiary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0" aria-hidden="true" />
						</div>
						<span class="text-caption text-ink-subtle group-hover:text-ink truncate transition-colors duration-200">
							github.com/Siva9493-tech
