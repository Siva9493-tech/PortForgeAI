		<section class="reveal-item mb-14 w-full" style="--stagger-delay: 560ms;" aria-labelledby="education-heading">
			<div class="mb-5 flex flex-col gap-1">
				<span class="text-caption font-semibold tracking-wider uppercase text-primary">
					Academic Foundation
				</span>
				<h2 id="education-heading" class="text-2xl font-bold tracking-tight text-ink md:text-3xl">
					Education
				</h2>
			</div>

			<div class="w-full rounded-xl border border-hairline bg-surface-1 p-6 shadow-subtle">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
					<div class="flex flex-col gap-1">
						<h3 class="text-lg font-semibold text-ink">
							Vasireddy Venkatadri International Technological University
						</h3>
						<p class="text-body-sm text-ink-muted">
							Bachelor of Technology (B.Tech) — Computer Science &amp; Engineering (AI &amp; ML)
						</p>
					</div>

					<span class="inline-flex shrink-0 w-fit items-center rounded-pill border border-hairline bg-surface-2 px-3 py-1 text-caption font-medium text-primary">
						3rd Year
					</span>
				</div>
			</div>
		</section>

		<!-- Section: Connect / Get in Touch -->
		<section class="reveal-item w-full" style="--stagger-delay: 620ms;" aria-labelledby="connect-heading">
			<div class="w-full rounded-xl border border-hairline bg-surface-1 p-6 sm:p-8 shadow-subtle">
				<div class="mb-4 flex flex-col gap-1">
					<span class="text-caption font-semibold tracking-wider uppercase text-primary">
						Let's Connect
					</span>
					<h2 id="connect-heading" class="text-2xl font-bold tracking-tight text-ink md:text-3xl">
						Get in Touch
					</h2>
					<p class="text-body text-ink-subtle mt-1 leading-relaxed">
						Open to conversations about AI/ML initiatives, software engineering opportunities, product feedback, or collaborative ideas.
					</p>
				</div>

				<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3 w-full">
					<!-- Email Card -->
					<div class="flex w-full min-w-0 flex-col justify-between rounded-lg border border-hairline bg-surface-2 p-4 transition-colors duration-200 hover:border-hairline-strong">
						<div class="flex items-center gap-2.5 mb-3">
							<span class="flex h-8 w-8 items-center justify-center rounded-md bg-surface-3 text-ink-muted shrink-0" aria-hidden="true">
								<Mail size="16" />
							</span>
							<span class="text-body-sm font-medium text-ink">Email</span>
						</div>
						<div class="flex flex-col gap-2 min-w-0">
							<a
								href="mailto:mamidalasivabalaji@gmail.com"
								id="connect-email-link"
								class="text-caption text-ink-subtle hover:text-ink truncate transition-colors duration-200"
								title="mamidalasivabalaji@gmail.com"
							>
								mamidalasivabalaji@gmail.com
							</a>
							<button
								type="button"
								id="btn-copy-email"
								data-email="mamidalasivabalaji@gmail.com"
								class="inline-flex shrink-0 items-center gap-1.5 text-caption font-medium text-primary hover:text-primary-hover transition-colors duration-200 w-fit"
							>
								<Copy size="12" id="copy-icon" aria-hidden="true" />
								<Check size="12" id="check-icon" class="hidden text-semantic-success" aria-hidden="true" />
