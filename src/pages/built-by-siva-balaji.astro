			<!-- AI Hub Collaboration Block -->
			<section class="reveal-item flex w-full flex-col rounded-xl border border-hairline bg-surface-1 p-6 shadow-subtle min-w-0" style="--stagger-delay: 450ms;" aria-labelledby="ai-hub-heading">
				<div class="mb-4 flex items-center gap-2">
					<span class="flex h-7 w-7 items-center justify-center rounded-md bg-surface-2 text-primary" aria-hidden="true">
