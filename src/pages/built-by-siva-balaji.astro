---
import {
	ArrowLeft,
	ArrowUpRight,
	Brain,
	Check,
	Code2,
	Compass,
	Copy,
	Cpu,
	ExternalLink,
	Github,
	GraduationCap,
	Layers,
	Linkedin,
	Mail,
	Sparkles,
	Terminal,
} from 'lucide-astro';
import DashboardLayout from '../components/dashboard/DashboardLayout.astro';

const title = 'Built by Siva Balaji — PortForge AI';
const description =
	'Meet M. Siva Balaji, the student developer and AI/ML builder behind PortForge AI.';

const currentFocusAreas = [
	{ label: 'Artificial Intelligence', icon: Brain },
	{ label: 'Machine Learning', icon: Cpu },
	{ label: 'Computer Vision', icon: Sparkles },
	{ label: 'AI Automation', icon: Terminal },
	{ label: 'Software Development', icon: Code2 },
	{ label: 'Data / ML Workflows', icon: Layers },
	{ label: 'Product Building', icon: Compass },
];
---

<DashboardLayout title={title} description={description} pageLabel="Built by Siva Balaji">
	<div class="profile-container w-full mx-auto max-w-4xl pb-20 pt-2 sm:pt-4">
		<!-- Top Navigation / Return to Dashboard -->
		<nav class="reveal-item mb-8 flex w-full items-center justify-between gap-4" style="--stagger-delay: 50ms;" aria-label="Breadcrumb navigation">
			<a
				href="/dashboard"
				id="back-to-dashboard"
				class="group inline-flex shrink-0 items-center gap-2 rounded-md border border-hairline bg-surface-1 px-3 py-1.5 text-body-sm font-medium text-ink-subtle transition-all duration-200 hover:border-hairline-strong hover:bg-surface-2 hover:text-ink focus-visible:outline-2"
			>
				<ArrowLeft size="15" class="transition-transform duration-200 group-hover:-translate-x-0.5 text-ink-tertiary group-hover:text-ink" aria-hidden="true" />
				<span>Back to Dashboard</span>
			</a>

			<span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill border border-hairline bg-surface-2 px-3 py-1 text-caption font-medium tracking-wide uppercase text-ink-tertiary">
				<span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
				Builder Profile
			</span>
		</nav>

		<!-- Hero Section -->
		<header class="reveal-item mb-14 w-full" style="--stagger-delay: 110ms;">
			<div class="flex w-full flex-col sm:flex-row sm:items-start sm:justify-between gap-8 sm:gap-10">
				<!-- Profile Photo: On mobile (flex-col) order-1 places it at the top; on desktop (sm:flex-row) sm:order-2 places it on the right -->
				<div class="profile-photo-wrapper order-1 sm:order-2 shrink-0 self-start sm:self-start" style="--photo-delay: 180ms;">
					<div class="relative h-32 w-32 overflow-hidden rounded-2xl border border-hairline-strong bg-surface-2 shadow-elevated ring-1 ring-hairline sm:h-40 sm:w-40 md:h-44 md:w-44">
						<img
							src="/siva-balaji.jpg"
							alt="M. Siva Balaji — Builder of PortForge AI"
							width="176"
							height="176"
							loading="eager"
							class="h-full w-full object-cover object-[50%_25%]"
						/>
					</div>
				</div>

				<!-- Hero Text Content: On mobile order-2 places it below the photo with full width; on desktop sm:order-1 places it on the left -->
				<div class="order-2 sm:order-1 flex w-full sm:flex-1 flex-col gap-3 min-w-0">
					<div class="flex items-center gap-2">
						<span class="text-caption font-semibold tracking-wider uppercase text-primary">
							BUILDER · AI/ML · SOFTWARE
						</span>
					</div>

					<h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl md:text-5xl leading-tight">
						M. Siva Balaji
					</h1>

					<div class="flex flex-col gap-1 text-body-sm sm:text-body text-ink-subtle">
						<p class="font-medium text-ink-muted">
							B.Tech — 3rd Year · Computer Science & Engineering (AI & ML)
						</p>
						<p class="text-ink-tertiary">
							Vasireddy Venkatadri International Technological University
						</p>
					</div>

					<p class="mt-2 text-body text-ink-subtle leading-relaxed max-w-2xl">
						Student developer passionate about Artificial Intelligence, Machine Learning, and building practical, user-first software tools. Creator and lead builder of PortForge AI.
					</p>

					<!-- Hero Social & Contact Links -->
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<a
							href="https://www.linkedin.com/in/m-siva-balaji/"
							target="_blank"
							rel="noopener noreferrer"
							id="hero-linkedin-link"
							class="inline-flex shrink-0 items-center gap-2 rounded-md border border-hairline bg-surface-1 px-3.5 py-2 text-body-sm font-medium text-ink transition-colors duration-200 hover:border-hairline-strong hover:bg-surface-2 focus-visible:outline-2"
							aria-label="Siva Balaji's LinkedIn profile (opens in new tab)"
						>
							<Linkedin size="16" class="text-[#0a66c2]" aria-hidden="true" />
							<span>LinkedIn</span>
							<ArrowUpRight size="13" class="text-ink-tertiary" aria-hidden="true" />
						</a>

						<a
							href="https://github.com/Siva9493-tech"
							target="_blank"
							rel="noopener noreferrer"
							id="hero-github-link"
							class="inline-flex shrink-0 items-center gap-2 rounded-md border border-hairline bg-surface-1 px-3.5 py-2 text-body-sm font-medium text-ink transition-colors duration-200 hover:border-hairline-strong hover:bg-surface-2 focus-visible:outline-2"
							aria-label="Siva Balaji's GitHub profile (opens in new tab)"
						>
							<Github size="16" class="text-ink-muted" aria-hidden="true" />
							<span>GitHub</span>
							<ArrowUpRight size="13" class="text-ink-tertiary" aria-hidden="true" />
						</a>

						<a
							href="mailto:mamidalasivabalaji@gmail.com"
							id="hero-email-link"
