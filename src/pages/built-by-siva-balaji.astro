						</div>
					</div>

					<!-- LinkedIn Card -->
					<a
						href="https://www.linkedin.com/in/m-siva-balaji/"
						target="_blank"
						rel="noopener noreferrer"
						id="connect-linkedin-link"
						class="group flex w-full min-w-0 flex-col justify-between rounded-lg border border-hairline bg-surface-2 p-4 transition-colors duration-200 hover:border-hairline-strong focus-visible:outline-2"
						aria-label="Connect with Siva Balaji on LinkedIn (opens in new tab)"
					>
						<div class="flex items-center justify-between mb-3">
							<div class="flex items-center gap-2.5">
								<span class="flex h-8 w-8 items-center justify-center rounded-md bg-surface-3 text-[#0a66c2] shrink-0" aria-hidden="true">
