			</section>

			<!-- Academic & Project Guidance Block -->
			<section class="reveal-item flex w-full flex-col rounded-xl border border-hairline bg-surface-1 p-6 shadow-subtle min-w-0" style="--stagger-delay: 510ms;" aria-labelledby="faculty-guidance-heading">
