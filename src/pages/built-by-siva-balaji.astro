</DashboardLayout>

<style>
	/* Portfolio-grade progressive reveal motion */
	@keyframes profileReveal {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes photoReveal {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(8px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.reveal-item {
		animation: profileReveal var(--duration-slow, 350ms) var(--ease-out-soft, cubic-bezier(0.16, 1, 0.3, 1)) both;
		animation-delay: var(--stagger-delay, 0ms);
	}

	.profile-photo-wrapper {
		animation: photoReveal var(--duration-deliberate, 450ms) var(--ease-out-soft, cubic-bezier(0.16, 1, 0.3, 1)) both;
		animation-delay: var(--photo-delay, 180ms);
	}

	/* Stable container width and clean word-wrapping (avoid character-by-character collapse) */
	.profile-container {
		width: 100%;
		overflow-wrap: break-word;
		word-break: normal;
	}

	/* Respect reduced motion globally */
	@media (prefers-reduced-motion: reduce) {
		.reveal-item,
		.profile-photo-wrapper {
			animation: none !important;
			transform: none !important;
		}
	}
</style>

<script>
	// Copy email address functionality with feedback
	const copyBtn = document.getElementById('btn-copy-email') as HTMLButtonElement | null;
	const copyIcon = document.getElementById('copy-icon');
	const checkIcon = document.getElementById('check-icon');
	const copyText = document.getElementById('copy-text');

	if (copyBtn && copyIcon && checkIcon && copyText) {
		let timeoutId: number | undefined;

		copyBtn.addEventListener('click', async () => {
			const email = copyBtn.dataset.email || 'mamidalasivabalaji@gmail.com';

			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(email);
				} else {
					window.prompt('Copy email address:', email);
				}

				// Show success feedback
				copyIcon.classList.add('hidden');
				checkIcon.classList.remove('hidden');
				copyText.textContent = 'Copied to clipboard!';
				copyBtn.classList.add('text-semantic-success');

				if (timeoutId) window.clearTimeout(timeoutId);
				timeoutId = window.setTimeout(() => {
					copyIcon.classList.remove('hidden');
					checkIcon.classList.add('hidden');
					copyText.textContent = 'Copy address';
					copyBtn.classList.remove('text-semantic-success');
				}, 2000);
			} catch (err) {
				console.error('Failed to copy email:', err);
			}
		});
	}
</script>
