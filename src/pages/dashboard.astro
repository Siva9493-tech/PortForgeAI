---
// STEP 10: authenticated app pages stay statically generated. Client-side
// session gating (ProtectedRoute) is preserved as-is; only the public
// portfolio slug route is rendered on the server at request time.
export const prerender = true;

import AnalyticsActivitySection from '../components/dashboard/AnalyticsActivitySection.astro';
import AnalyticsCards from '../components/dashboard/AnalyticsCards.astro';
import DashboardLayout from '../components/dashboard/DashboardLayout.astro';
import EmptyState from '../components/dashboard/EmptyState.astro';
import QuickActions from '../components/dashboard/QuickActions.astro';
import RecentPortfolios from '../components/dashboard/RecentPortfolios.astro';
import WelcomeSection from '../components/dashboard/WelcomeSection.astro';

const title = 'Dashboard — PortForge AI';
const description = 'Build and manage your AI-powered portfolio from your PortForge AI dashboard.';
---

<DashboardLayout title={title} description={description} pageLabel="Dashboard">
	<WelcomeSection />

	<AnalyticsCards />

	<AnalyticsActivitySection />

	<QuickActions />

	<RecentPortfolios />

	<EmptyState />
</DashboardLayout>

<script>
	import { ensureUserProfile, waitForInitialAuth } from '../lib/auth';

	// OAuth sign-in redirects the browser back here, so this page is the one
	// reliable place to catch a newly authenticated user who never pressed a form
	// button. It is idempotent: for an existing profile it is a no-op read, and
	// for a brand-new user it creates the row (using metadata name when present).
	(async () => {
		try {
			const session = await waitForInitialAuth();
			if (session?.user) {
				const { error } = await ensureUserProfile(session.user);
				if (error) {
					console.error('[dashboard] Failed to ensure profile for user:', error);
				}
			}
		} catch (error) {
			console.error('[dashboard] Failed to resolve authentication session:', error);
		}
	})();
</script>
