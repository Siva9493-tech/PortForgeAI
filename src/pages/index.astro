---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Templates from '../components/sections/Templates.astro';
import Pricing from '../components/sections/Pricing.astro';
import About from '../components/sections/About.astro';
import Footer from '../components/sections/Footer.astro';

const title = 'PortForge AI — Build a portfolio that sounds senior';
const description =
	'PortForge AI turns your GitHub, projects, and words into a fast, mobile-first portfolio. AI writing, modern templates, and static exports.';
---

<Layout title={title} description={description}>
	<main>
		<Hero />
		<Features />
		<Templates />
		<Pricing />
		<About />
	</main>
	<Footer />
</Layout>