---
import { Github, Globe, Instagram, Link2, Linkedin, Mail, Share2, Twitter, Youtube } from 'lucide-astro';
import type { PortfolioOutput } from '../../lib/ai';
import { resolveIdentityLinks, type PublicSocialKind } from '../../lib/portfolio';
import type { PortfolioTheme } from '../../lib/themes';
import SectionWrapper from './SectionWrapper.astro';

interface Props {
	/** The normalized output driving every link in this section. */
	portfolio: PortfolioOutput;
	theme: PortfolioTheme;
}

const { portfolio, theme } = Astro.props;
const presentation = theme.presentation;

const ICONS: Record<PublicSocialKind, typeof Github> = {
	linkedin: Linkedin,
	github: Github,
	email: Mail,
	website: Globe,
	twitter: Twitter,
	instagram: Instagram,
	youtube: Youtube,
	other: Link2,
};

/** The complete set of legitimate identity links, from the shared resolver. */
const links = resolveIdentityLinks(portfolio);
---

{
	links.length > 0 && (
		<SectionWrapper
			id="social"
			heading="Find Me Online"
			eyebrow="Connectivity"
			theme={theme}
			bodyClass="mt-lg flex flex-wrap items-center gap-xs sm:gap-sm"
		>
			<Share2 slot="icon" size="20" class={presentation.accent} aria-hidden="true" />
			{
				links.map((link) => {
					const Icon = ICONS[link.kind];
					const trackType =
						link.kind === 'linkedin' ? 'linkedin_click' : link.kind === 'github' ? 'github_click' : null;
					const external = link.href.startsWith('http');
					return (
						<a
							class={`group btn ${presentation.ghostButton}`}
							href={link.href}
							{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							{...(trackType ? { 'data-analytics-click': trackType } : {})}
						>
							<Icon size="15" class="icon-inline transition-transform duration-fast group-hover:scale-110" aria-hidden="true" />
							<span>{link.label}</span>
						</a>
					);
				})
			}
		</SectionWrapper>
	)
}