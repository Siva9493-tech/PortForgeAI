---
import { Download, Github, Linkedin, Mail } from 'lucide-astro';
import type { PortfolioOutput, PortfolioResume } from '../../lib/ai';
import { resolveIdentityLinks } from '../../lib/portfolio';
import type { PortfolioTheme } from '../../lib/themes';
import SectionWrapper from './SectionWrapper.astro';

interface Props {
	/** The normalized output driving every action in this section. */
	portfolio: PortfolioOutput;
	resume: PortfolioResume | null;
	theme: PortfolioTheme;
}

const { portfolio, resume, theme } = Astro.props;
const presentation = theme.presentation;

const ICONS: Record<'linkedin' | 'github' | 'email', typeof Mail> = {
	linkedin: Linkedin,
	github: Github,
	email: Mail,
};

interface ContactAction {
	label: string;
	href: string;
	icon: typeof Mail;
	trackType: string;
}

const links = resolveIdentityLinks(portfolio);

const actions: ContactAction[] = [];
for (const kind of ['linkedin', 'github', 'email'] as const) {
	const link = links.find((entry) => entry.kind === kind);
	if (link) {
		actions.push({ label: link.label, href: link.href, icon: ICONS[kind], trackType: 'contact_click' });
	}
}
if (resume?.fileUrl) {
	actions.push({ label: 'Download Resume', href: resume.fileUrl, icon: Download, trackType: 'resume_click' });
}
---

{
	(actions.length > 0 || resume) && (
		<SectionWrapper id="contact" heading="Get in Touch" theme={theme} bodyClass="mt-lg flex flex-wrap gap-sm">
			<Mail slot="icon" size="20" class={presentation.accent} aria-hidden="true" />
			{
				actions.map((action) => (
					<a
						class={presentation.button}
						href={action.href}
						data-analytics-click={action.trackType}
						{...(action.href.startsWith('http')
							? { target: '_blank', rel: 'noopener noreferrer' }
							: {})}
					>
						<action.icon size="16" aria-hidden="true" />
						{action.label}
					</a>
				))
			}
			{
				resume && !resume.fileUrl && (
					<p class="text-body-sm text-ink-muted">
						Resume attached: {resume.fileName || 'resume'}
					</p>
				)
			}
		</SectionWrapper>
	)
}