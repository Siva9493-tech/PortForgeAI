---
import { Trophy, ExternalLink } from 'lucide-astro';
import type { PortfolioAchievement } from '../../lib/ai';
import type { PortfolioTheme } from '../../lib/themes';
import SectionWrapper from './SectionWrapper.astro';

interface Props {
	achievements: PortfolioAchievement[];
	theme: PortfolioTheme;
}

const { achievements, theme } = Astro.props;
const presentation = theme.presentation;
---

{
	achievements.length > 0 && (
		<SectionWrapper
			id="achievements"
			heading="Honors & Achievements"
			eyebrow="Recognition"
			theme={theme}
			bodyClass="mt-lg grid grid-cols-1 gap-md md:grid-cols-2"
		>
			<Trophy slot="icon" size="20" class={presentation.accent} aria-hidden="true" />
			{
				achievements.map((achievement) => (
					<article
						class="card-subtle card-interactive flex flex-col justify-between gap-sm card-p-sm"
					>
						<div class="flex flex-col gap-xs">
							<div class="flex items-start justify-between gap-xs min-w-0">
								<div class="flex flex-wrap items-center gap-xs">
									<div class="icon-box-accent icon-box-sm shrink-0" aria-hidden="true">
										<Trophy size="13" />
									</div>
									{achievement.organization && (
										<span class="badge badge-neutral break-words">{achievement.organization}</span>
									)}
									{achievement.category && (
										<span class="badge badge-accent break-words">{achievement.category}</span>
									)}
								</div>
								{achievement.date && (
									<span class="type-meta font-mono text-ink-subtle shrink-0">
										{achievement.date}
									</span>
								)}
							</div>
							<h3 class={`type-heading-sub ${presentation.display} text-ink break-words min-w-0`}>
								{achievement.title}
							</h3>
							{achievement.description && (
								<p class="type-body-sm text-ink-muted leading-relaxed break-words">{achievement.description}</p>
							)}
						</div>
						{achievement.link && (
							<div class="pt-xs border-t border-hairline-subtle">
								<a
									class="link-action group"
									href={achievement.link}
									target="_blank"
									rel="noopener noreferrer"
								>
									<ExternalLink size="14" class="icon-inline transition-transform duration-fast group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
									<span>Learn more</span>
								</a>
							</div>
						)}
					</article>
				))
			}
		</SectionWrapper>
	)
}