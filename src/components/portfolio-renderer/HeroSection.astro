---
import { ArrowRight, Download, Github, Globe, Linkedin, Mail, MapPin, Sparkles } from 'lucide-astro';
import type { PortfolioOutput } from '../../lib/ai';
import { resolveHero } from '../../lib/portfolio';
import type { PortfolioTheme } from '../../lib/themes';

interface Props {
	/** The normalized output driving every value in this Hero. */
	portfolio: PortfolioOutput;
	theme: PortfolioTheme;
}

const { portfolio, theme } = Astro.props;
const presentation = theme.presentation;
const hero = resolveHero(portfolio);
const hasPhoto = Boolean(hero.photo?.dataUrl);
---

<section
	id="hero"
	aria-labelledby="hero-heading"
	class={`grid grid-cols-1 gap-lg ${hasPhoto ? 'md:grid-cols-2 md:items-center md:gap-xl' : ''} ${presentation.sectionSpacing}`}
>
	<div class="flex flex-col gap-md">
		<div class="badge badge-accent self-start shadow-subtle">
			<Sparkles size="13" class={presentation.accent} aria-hidden="true" />
			<span>Portfolio</span>
		</div>
		<h1
			id="hero-heading"
			class={`type-display break-words ${presentation.display} ${presentation.heading}`}
		>
			{hero.name || 'Portfolio'}
		</h1>
		{
			hero.headline && (
				<p
					class={`type-heading-sub max-w-prose break-words font-medium ${presentation.display} ${presentation.heading}`}
				>
					{hero.headline}
				</p>
			)
		}
		{
			hero.introduction && (
				<p class="type-body max-w-prose leading-relaxed text-ink-muted">{hero.introduction}</p>
			)
		}
		{
			hero.location && (
				<p class="type-meta flex items-center gap-xs text-ink-subtle">
					<MapPin size="14" class="icon-inline" aria-hidden="true" />
					Based in {hero.location}
				</p>
			)
		}
		{
			hero.keywords.length > 0 && (
				<ul class="flex flex-wrap gap-xs" aria-label="Portfolio keywords">
					{hero.keywords.map((keyword) => (
						<li class="pill pill-default">
							{keyword}
						</li>
					))}
				</ul>
			)
		}
		{
			hero.links.length > 0 && (
				<ul class="flex flex-wrap items-center gap-md" aria-label="Profile links">
					{hero.links.map((link) => (
						<li>
							<a
								href={link.href}
								{...(link.href.startsWith('http')
									? { target: '_blank', rel: 'noopener noreferrer' }
									: {})}
								class="link-subtle group inline-flex items-center gap-xs py-xxs text-body-sm"
							>
								{link.kind === 'linkedin' && <Linkedin size="16" class="icon-inline" aria-hidden="true" />}
								{link.kind === 'github' && <Github size="16" class="icon-inline" aria-hidden="true" />}
								{link.kind === 'email' && <Mail size="16" class="icon-inline" aria-hidden="true" />}
								{link.kind === 'website' && <Globe size="16" class="icon-inline" aria-hidden="true" />}
								<span>{link.label}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
		{
			hero.ctas.length > 0 && (
				<div class="flex flex-wrap items-center gap-sm">
					{hero.ctas.map((cta) => (
						<a
							href={cta.href}
							class={`group btn ${cta.variant === 'primary' ? presentation.button : presentation.ghostButton}`}
							{...(cta.analytics ? { 'data-analytics-click': cta.analytics } : {})}
							{...(cta.href.startsWith('http')
								? { target: '_blank', rel: 'noopener noreferrer' }
								: {})}
						>
							<span>{cta.label}</span>
							{cta.icon === 'arrow' && (
								<ArrowRight size="16" class="icon-inline transition-transform duration-fast group-hover:translate-x-0.5" aria-hidden="true" />
							)}
							{cta.icon === 'download' && (
								<Download size="16" class="icon-inline transition-transform duration-fast group-hover:translate-y-0.5" aria-hidden="true" />
							)}
						</a>
					))}
				</div>
			)
		}
	</div>
	{
		hasPhoto && (
			<div class="flex justify-center md:justify-end">
				<div class="size-40 overflow-hidden rounded-full border border-hairline-strong bg-surface-2 p-1 shadow-elevated md:size-52">
					<img
						src={hero.photo?.dataUrl}
						alt={hero.name ? `${hero.name} profile photo` : 'Profile photo'}
						class="size-full rounded-full object-cover"
					/>
				</div>
			</div>
		)
	}
</section>