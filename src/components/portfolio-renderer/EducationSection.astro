---
import { GraduationCap } from 'lucide-astro';
import type { PortfolioEducation } from '../../lib/ai';
import type { PortfolioTheme } from '../../lib/themes';
import SectionWrapper from './SectionWrapper.astro';

interface Props {
	education: PortfolioEducation[];
	theme: PortfolioTheme;
}

const { education, theme } = Astro.props;
const presentation = theme.presentation;

function formatYears(entry: PortfolioEducation): string {
	const parts: string[] = [];
	if (entry.startYear) {
		parts.push(entry.startYear);
	}
	if (entry.endYear) {
		parts.push(entry.endYear);
	}
	return parts.length ? parts.join(' — ') : '';
}
---

{
	education.length > 0 && (
		<SectionWrapper
			id="education"
			heading="Education"
			eyebrow="Academic Background"
			theme={theme}
			bodyClass="mt-lg flex flex-col divide-y divide-hairline-subtle"
		>
			<GraduationCap slot="icon" size="20" class={presentation.accent} aria-hidden="true" />
			{
				education.map((entry) => (
					<article class="flex flex-col gap-xs py-md first:pt-0 last:pb-0">
						<div class="flex flex-col gap-xxs sm:flex-row sm:items-baseline sm:justify-between sm:gap-sm min-w-0">
							<div class="min-w-0">
								<h3 class={`type-heading-sub ${presentation.display} text-ink break-words min-w-0`}>
									{entry.degree}
								</h3>
								<p class="type-body-sm text-ink-muted break-words">
									{entry.institution}
									{entry.fieldOfStudy && <span class="text-ink-subtle"> · {entry.fieldOfStudy}</span>}
								</p>
							</div>
							<div class="flex items-center gap-xs pt-xxs sm:pt-0 shrink-0">
								{
									entry.cgpa && (
										<span class="badge badge-neutral">
											CGPA: {entry.cgpa}
										</span>
									)
								}
								{
									formatYears(entry) && (
										<span class="type-meta font-mono shrink-0 text-ink-subtle">
											{formatYears(entry)}
										</span>
									)
								}
							</div>
						</div>
						{entry.description && (
							<p class="type-body-sm max-w-prose pt-xs leading-relaxed text-ink-subtle break-words">
								{entry.description}
							</p>
						)}
					</article>
				))
			}
		</SectionWrapper>
	)
}