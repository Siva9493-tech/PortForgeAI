---
import type { PortfolioTheme } from '../../lib/themes';

interface Props {
	/** Section id, also used to derive the heading's `aria-labelledby` id. */
	id: string;
	/** Visible heading text. */
	heading: string;
	/** Heading level (logical hierarchy); defaults to 2. */
	headingLevel?: 2 | 3;
	/** Selected presentation theme, forwarded by the renderer coordinator. */
	theme: PortfolioTheme;
	/** Classes for the section element. */
	className?: string;
	/** Classes for the content wrapper inside the section. */
	bodyClass?: string;
}

const {
	id,
	heading,
	headingLevel = 2,
	theme,
	className,
	bodyClass = 'mt-lg grid grid-cols-1 gap-lg md:grid-cols-2',
} = Astro.props;

const presentation = theme.presentation;
const HeadingTag: 'h2' | 'h3' = headingLevel === 3 ? 'h3' : 'h2';
const headingId = `${id}-heading`;
const sectionClass = className ?? presentation.sectionSpacing;
---

<section id={id} aria-labelledby={headingId} class={sectionClass}>
	<div class="flex items-center gap-sm">
		<slot name="icon" />
		<HeadingTag id={headingId} class={`${presentation.display} text-headline ${presentation.heading}`}>
			{heading}
		</HeadingTag>
	</div>
	<div class={bodyClass}>
		<slot />
	</div>
</section>