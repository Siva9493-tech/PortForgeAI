---
import type { PortfolioTheme } from '../../lib/themes';

interface Props {
	/** Section id, also used to derive the heading's `aria-labelledby` id. */
	id: string;
	/** Visible heading text. */
	heading: string;
	/** Optional category/eyebrow kicker above the heading. */
	eyebrow?: string;
	/** Optional descriptive subtitle below the heading. */
	subtitle?: string;
	/** Heading level (logical hierarchy); defaults to 2. */
	headingLevel?: 2 | 3;
	/** Selected presentation theme, forwarded by the renderer coordinator. */
	theme: PortfolioTheme;
	/** Classes for the section element. */
	className?: string;
	/** Classes for the header wrapper. */
	headerClass?: string;
	/** Classes for the body wrapper. */
	bodyClass?: string;
	/** Specific choreography mode for section entrance. */
	revealMode?: 'default' | 'projects' | 'timeline' | 'compact' | 'none';
}

const {
	id,
	heading,
	eyebrow,
	subtitle,
	headingLevel = 2,
	theme,
	className,
	headerClass = 'flex flex-col gap-xs',
	bodyClass = 'mt-lg grid grid-cols-1 gap-lg md:grid-cols-2',
	revealMode = 'default',
} = Astro.props;

const presentation = theme.presentation;
const HeadingTag: 'h2' | 'h3' = headingLevel === 3 ? 'h3' : 'h2';
const headingId = `${id}-heading`;
const sectionClass = className ?? presentation.sectionSpacing;

const sectionRevealAttr =
	revealMode === 'projects'
		? { 'data-reveal-projects': '' }
		: revealMode === 'timeline'
			? { 'data-reveal-timeline': '' }
			: revealMode === 'none'
				? {}
				: { 'data-reveal': '' };

const bodyRevealAttr =
	revealMode === 'compact'
		? { 'data-reveal-group': 'compact' }
		: revealMode === 'timeline'
			? { 'data-timeline-container': '' }
			: (revealMode === 'projects' || revealMode === 'none')
				? {}
				: { 'data-reveal-group': '' };
---

<section id={id} aria-labelledby={headingId} {...sectionRevealAttr} class={sectionClass}>
	<header class={headerClass}>
		{
			eyebrow && (
				<p class="type-eyebrow">{eyebrow}</p>
			)
		}
		<div class="flex items-center gap-sm">
			<slot name="icon" />
			<HeadingTag id={headingId} class={`type-heading-section ${presentation.display} ${presentation.heading}`}>
				{heading}
			</HeadingTag>
		</div>
		{
			subtitle && (
				<p class="type-body-sm max-w-prose text-ink-muted">{subtitle}</p>
			)
		}
	</header>
	<div class={bodyClass} {...bodyRevealAttr}>
		<slot />
	</div>
</section>