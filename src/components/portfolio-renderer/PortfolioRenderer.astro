---
import type {
	PortfolioAchievement,
	PortfolioCertification,
	PortfolioEducation,
	PortfolioExperience,
	PortfolioOutput,
	PortfolioProject,
	PortfolioResume,
	PortfolioSkill,
} from '../../lib/ai';
import type { PortfolioTheme } from '../../lib/themes';
import { resolveSectionNav } from '../../lib/portfolio';

import HeroSection from './HeroSection.astro';
import AboutSection from './AboutSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import ExperienceSection from './ExperienceSection.astro';
import EducationSection from './EducationSection.astro';
import SkillsSection from './SkillsSection.astro';
import CertificationsSection from './CertificationsSection.astro';
import AchievementsSection from './AchievementsSection.astro';
import SocialLinksSection from './SocialLinksSection.astro';
import ContactSection from './ContactSection.astro';
import SectionNav from './SectionNav.astro';
import FooterSection from './FooterSection.astro';

interface Props {
	/** The single source of truth for this render. */
	portfolio: PortfolioOutput;
	/** The selected presentation theme. */
	theme: PortfolioTheme;
}

const { portfolio, theme } = Astro.props;
const presentation = theme.presentation;

const projects: PortfolioProject[] = portfolio.projects;
const experience: PortfolioExperience[] = portfolio.experience;
const education: PortfolioEducation[] = portfolio.education;
const skills: PortfolioSkill[] = portfolio.skills;
const certifications: PortfolioCertification[] = portfolio.certifications;
const achievements: PortfolioAchievement[] = portfolio.achievements;
const resume: PortfolioResume | null = portfolio.resume;
const sectionNav = resolveSectionNav(portfolio);
---

<main
	id="portfolio-preview"
	class={`mx-auto w-full ${presentation.layout} px-md py-xl md:px-xl md:py-section ${presentation.font}`}
>
	{sectionNav.length > 0 && <SectionNav items={sectionNav} />}
	<HeroSection portfolio={portfolio} theme={theme} />
	<AboutSection portfolio={portfolio} theme={theme} />
	<ProjectsSection projects={projects} theme={theme} />
	<ExperienceSection experience={experience} theme={theme} />
	<EducationSection education={education} theme={theme} />
	<SkillsSection skills={skills} theme={theme} />
	<CertificationsSection certifications={certifications} theme={theme} />
	<AchievementsSection achievements={achievements} theme={theme} />
	<SocialLinksSection portfolio={portfolio} theme={theme} />
	<ContactSection portfolio={portfolio} resume={resume} theme={theme} />
	<FooterSection portfolio={portfolio} theme={theme} />
</main>