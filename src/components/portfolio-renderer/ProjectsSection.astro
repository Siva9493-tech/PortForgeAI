---
import { FolderGit2, Globe, ExternalLink } from 'lucide-astro';
import type { PortfolioProject } from '../../lib/ai';
import type { PortfolioTheme } from '../../lib/themes';
import SectionWrapper from './SectionWrapper.astro';

interface Props {
	projects: PortfolioProject[];
	theme: PortfolioTheme;
}

const { projects, theme } = Astro.props;
const presentation = theme.presentation;
---

{
	projects.length > 0 && (
		<SectionWrapper id="projects" heading="Projects" theme={theme} bodyClass="mt-lg grid grid-cols-1 gap-md md:grid-cols-2">
			<FolderGit2 slot="icon" size="20" class={presentation.accent} aria-hidden="true" />
			{
				projects.map((project) => (
					<article class={`${presentation.card} flex flex-col gap-xs p-md`}>
						<h3 class="text-card-title text-ink">{project.name}</h3>
						{
							project.role && <p class="text-caption text-ink-tertiary">{project.role}</p>
						}
						{
							project.description && (
								<p class="text-body-sm text-ink-muted">{project.description}</p>
							)
						}
						{
							project.highlights.length > 0 && (
								<ul class="flex flex-col gap-xs">
									{project.highlights.map((highlight) => (
										<li class="text-body-sm text-ink-muted">• {highlight}</li>
									))}
								</ul>
							)
						}
						{
							project.technologies.length > 0 && (
								<ul class="flex flex-wrap gap-xs" aria-label={`Technologies for ${project.name}`}>
									{project.technologies.map((tech) => (
										<li class="rounded-sm border border-hairline bg-surface-2 px-xs py-xxs text-caption text-ink-subtle">
											{tech}
										</li>
									))}
								</ul>
							)
						}
						{
							(project.repositoryUrl || project.liveUrl) && (
								<div class="mt-xs flex flex-wrap gap-sm">
									{project.repositoryUrl && (
										<a
											class="inline-flex items-center gap-xs text-button text-primary hover:text-primary-hover"
											href={project.repositoryUrl}
											target="_blank"
											rel="noopener noreferrer"
										>
											<ExternalLink size="16" aria-hidden="true" />
											Repository
										</a>
									)}
									{project.liveUrl && (
										<a
											class="inline-flex items-center gap-xs text-button text-primary hover:text-primary-hover"
											href={project.liveUrl}
											target="_blank"
											rel="noopener noreferrer"
										>
											<Globe size="16" aria-hidden="true" />
											Live Demo
										</a>
									)}
								</div>
							)
						}
					</article>
				))
			}
		</SectionWrapper>
	)
}