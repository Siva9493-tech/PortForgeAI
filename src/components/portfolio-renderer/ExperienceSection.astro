---
import { Briefcase } from 'lucide-astro';
import type { PortfolioExperience } from '../../lib/ai';
import type { PortfolioTheme } from '../../lib/themes';
import SectionWrapper from './SectionWrapper.astro';

interface Props {
	experience: PortfolioExperience[];
	theme: PortfolioTheme;
}

const { experience, theme } = Astro.props;
const presentation = theme.presentation;

function formatPeriod(entry: PortfolioExperience): string {
	if (entry.currentlyWorking) {
		return entry.startDate ? `${entry.startDate} — Present` : 'Present';
	}
	if (entry.startDate && entry.endDate) {
		return `${entry.startDate} — ${entry.endDate}`;
	}
	return entry.startDate || entry.endDate || '';
}
---

{
	experience.length > 0 && (
		<SectionWrapper
			id="experience"
			heading="Experience"
			eyebrow="Career Journey"
			theme={theme}
			bodyClass="mt-lg relative border-l border-hairline pl-md sm:pl-lg ml-xs sm:ml-sm flex flex-col gap-lg"
		>
			<Briefcase slot="icon" size="20" class={presentation.accent} aria-hidden="true" />
			{
				experience.map((entry) => (
					<article class="group relative flex flex-col gap-xs">
						<div
							class="absolute -left-[calc(var(--spacing-md)+5px)] sm:-left-[calc(var(--spacing-lg)+5px)] top-1.5 size-2.5 rounded-full border border-hairline-strong bg-primary shadow-subtle transition-transform duration-fast group-hover:scale-125"
							aria-hidden="true"
						/>
						<div class="flex flex-col gap-xxs sm:flex-row sm:items-baseline sm:justify-between sm:gap-sm min-w-0">
							<h3 class={`type-heading-sub ${presentation.display} text-ink break-words min-w-0`}>
								{entry.role}
								{entry.company && <span class="text-ink-subtle font-normal"> · {entry.company}</span>}
							</h3>
							{
								formatPeriod(entry) && (
									<span class="type-meta font-mono shrink-0 text-ink-subtle">
										{formatPeriod(entry)}
									</span>
								)
							}
						</div>
						<div class="flex flex-wrap items-center gap-xs">
							{entry.currentlyWorking && (
								<span class="badge badge-accent">
									<span class="badge-dot" aria-hidden="true" />
									Current
								</span>
							)}
							{entry.employmentType && (
								<span class="badge badge-neutral">
									{entry.employmentType}
								</span>
							)}
							{entry.location && (
								<span class="type-meta text-ink-subtle">
									{entry.location}
								</span>
							)}
						</div>
						{entry.description && (
							<p class="type-body-sm max-w-prose pt-xxs leading-relaxed text-ink-muted break-words">
								{entry.description}
							</p>
						)}
					</article>
				))
			}
		</SectionWrapper>
	)
}