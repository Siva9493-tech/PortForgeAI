---
import { Bell, ChevronDown, LayoutDashboard, LogOut, Search, Sun } from 'lucide-astro';

interface Props {
	title?: string;
	subtitle?: string;
}

const { title = 'Dashboard', subtitle = 'Manage your portfolios and workspace' } = Astro.props;
---

<header
	class="flex h-14 shrink-0 items-center justify-between gap-sm border-b border-hairline px-md md:px-xl"
>
	<div class="flex min-w-0 items-center gap-sm">
		<span
			class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-surface-2 text-ink-muted md:hidden"
			aria-hidden="true"
		>
			<LayoutDashboard size="16" />
		</span>
		<div class="flex min-w-0 flex-col">
			<span class="truncate text-body-sm font-medium text-ink">{title}</span>
			<span class="hidden truncate text-caption text-ink-tertiary sm:block">{subtitle}</span>
		</div>
	</div>

	<div class="relative hidden w-full max-w-[22rem] flex-1 sm:block">
		<span
			class="pointer-events-none absolute inset-y-0 left-sm flex items-center text-ink-tertiary"
			aria-hidden="true"
		>
			<Search size="16" />
		</span>
		<input
			type="search"
			placeholder="Search portfolios…"
			aria-label="Search portfolios"
			class="w-full rounded-md border border-hairline bg-surface-2 py-sm pl-lg pr-sm text-body-sm text-ink transition-colors duration-200 placeholder:text-ink-tertiary focus:border-primary-focus"
		/>
	</div>

	<div class="flex shrink-0 items-center gap-sm" role="group" aria-label="Account actions">
		<button
			type="button"
			aria-label="Notifications"
			class="inline-flex h-8 w-8 items-center justify-center rounded-md text-ink-subtle transition-colors duration-200 hover:bg-surface-2 hover:text-ink"
		>
			<Bell size="16" aria-hidden="true" />
		</button>

		<button
			type="button"
			aria-label="Toggle theme"
			class="hidden sm:inline-flex h-8 w-8 items-center justify-center rounded-md text-ink-subtle transition-colors duration-200 hover:bg-surface-2 hover:text-ink"
		>
			<Sun size="16" aria-hidden="true" />
		</button>

		<div class="relative" data-profile-menu>
			<button
				type="button"
				id="profile-menu-button"
				aria-label="Profile menu"
				aria-haspopup="menu"
				aria-expanded="false"
				aria-controls="profile-menu-panel"
				class="inline-flex items-center gap-xs rounded-md border border-transparent py-xs pl-1 pr-xs transition-colors duration-200 hover:bg-surface-2"
			>
				<span
					class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-caption font-semibold text-on-primary"
					aria-hidden="true"
				>
					PF
				</span>
				<ChevronDown size="14" class="hidden text-ink-subtle sm:block" aria-hidden="true" />
			</button>

			<div
				id="profile-menu-panel"
				role="menu"
				aria-labelledby="profile-menu-button"
				class="absolute right-0 top-[calc(100%_+_0.5rem)] z-50 flex w-52 flex-col gap-xs rounded-md border border-hairline bg-surface-1 p-xs shadow-md"
				hidden
			>
				<p
					data-logout-error
					class="rounded-md bg-surface-2 px-sm py-xs text-caption text-semantic-danger"
					role="alert"
					hidden
				>
				</p>
				<button
					type="button"
					role="menuitem"
					data-logout
					class="inline-flex items-center gap-sm rounded-md px-sm py-xs text-body-sm text-ink transition-colors duration-200 hover:bg-surface-2 disabled:cursor-not-allowed disabled:opacity-60"
				>
					<LogOut size="16" class="text-ink-subtle" aria-hidden="true" />
					Sign out
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	import { signOut } from '../../lib/auth';
	import { portfolioManagerStore } from '../../lib/portfolio-manager';

	const container = document.querySelector<HTMLElement>('[data-profile-menu]');
	const button = document.getElementById('profile-menu-button');
	const panel = document.getElementById('profile-menu-panel');
	const logoutButton = container?.querySelector<HTMLButtonElement>('[data-logout]');
	const logoutError = container?.querySelector<HTMLElement>('[data-logout-error]');

	if (container && button && panel && logoutButton) {
		const isOpen = (): boolean => !panel.hidden;

		const setOpen = (open: boolean): void => {
			panel.hidden = !open;
			button.setAttribute('aria-expanded', String(open));
			if (open) {
				logoutButton.focus();
			}
		};

		button.addEventListener('click', (event) => {
			event.stopPropagation();
			setOpen(!isOpen());
		});

		// Behave like a real menu: dismiss on an outside click or Escape.
		document.addEventListener('click', (event) => {
			if (isOpen() && !container.contains(event.target as Node)) {
				setOpen(false);
			}
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) {
				setOpen(false);
				button.focus();
			}
		});

		logoutButton.addEventListener('click', async () => {
			if (logoutError) logoutError.hidden = true;
			logoutButton.disabled = true;
			logoutButton.setAttribute('aria-busy', 'true');

			// The Supabase session is the source of truth: sign out through the
			// shared browser client and only redirect when it actually succeeded,
			// so a failed logout is never reported to the user as a success.
			const { error } = await signOut();

			if (error) {
				logoutButton.disabled = false;
				logoutButton.removeAttribute('aria-busy');
				if (logoutError) {
					logoutError.textContent = 'Could not sign out. Please try again.';
					logoutError.hidden = false;
				}
				console.error('[auth] Sign-out failed:', error);
				return;
			}

			// Session cleared. The store's own auth listener drops the authenticated
			// records; the fresh /login load starts from an unauthenticated store.
			// Wait for that SIGNED_OUT cleanup to finish BEFORE navigating, so the
			// `last-user` cache pointer is cleared and a previous account's user-scoped
			// cache can never be restored for the next account that signs in here.
			try {
				await portfolioManagerStore.hydrate();
				localStorage.removeItem('portforge:wizard:v1');
				localStorage.removeItem('portforge:builder-recovery:v1');
			} catch (cleanupError) {
				// The Supabase session is already gone; never let a cleanup hiccup
				// trap the user on a protected page — redirect regardless.
				console.error('[auth] Store cleanup after sign-out failed:', cleanupError);
			}

			window.location.assign('/login');

		});
	}
</script>