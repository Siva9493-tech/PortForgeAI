---
interface Props {
	/**
	 * Where to send unauthenticated users. Defaults to the login page.
	 */
	redirectTo?: string;
}

const { redirectTo = '/login' } = Astro.props;
---

<div class="root" data-protected-route data-redirect={redirectTo} aria-busy="true">
	<div class="loading" data-loading>
		<span class="spinner" aria-hidden="true"></span>
		<p class="mt-md text-body-sm text-ink-subtle">Checking your session…</p>
	</div>

	<div class="content" data-content hidden>
		<slot />
	</div>
</div>

<style>
	.root {
		position: relative;
	}
	.loading {
		display: flex;
		min-height: calc(100dvh - 3.5rem);
		align-items: center;
		justify-content: center;
		flex-direction: column;
	}
	.spinner {
		width: 2rem;
		height: 2rem;
		border-radius: 9999px;
		border: 2px solid var(--color-hairline);
		border-top-color: var(--color-primary);
		animation: pf-spin 0.8s linear infinite;
	}
	@keyframes pf-spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>

<script>
	import { getCurrentSession } from '../lib/auth';

	const root = document.querySelector<HTMLDivElement>('[data-protected-route]');
	if (root) {
		const redirectTo = root.getAttribute('data-redirect') ?? '/login';
		const loading = root.querySelector<HTMLDivElement>('[data-loading]');
		const content = root.querySelector<HTMLDivElement>('[data-content]');

		(async () => {
			try {
				const { data } = await getCurrentSession();
				if (data.session) {
					root.removeAttribute('aria-busy');
					if (loading) loading.hidden = true;
					if (content) content.hidden = false;
				} else {
					window.location.replace(redirectTo);
				}
			} catch {
				window.location.replace(redirectTo);
			}
		})();
	}
</script>