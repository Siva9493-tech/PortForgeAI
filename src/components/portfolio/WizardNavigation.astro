---
import { ArrowLeft, ArrowRight } from 'lucide-astro';
import { TOTAL_STEPS, WIZARD_STEPS, getBuilderProgress, wizardStore } from '../../lib/portfolio';

const isEdit = Boolean(new URL(Astro.url).searchParams.get('portfolio'));
const state = wizardStore.getState();
const currentIndex = WIZARD_STEPS.findIndex((step) => step.id === state.currentStep);
const currentStep = WIZARD_STEPS[Math.max(0, currentIndex)];
const prevStep = WIZARD_STEPS[currentIndex - 1];
const nextStep = WIZARD_STEPS[currentIndex + 1];
const isFirst = currentIndex === 0;
const isLast = currentIndex === WIZARD_STEPS.length - 1;
const progress = getBuilderProgress(state.data);
const percent = progress.percent;
const percentLabel = `${progress.completed} of ${progress.total} sections complete (${percent}%)`;
const finalLabel = isEdit ? 'Save Changes' : 'Save Portfolio';
---

<nav
	id="wizard-navigation"
	aria-label="Portfolio wizard navigation"
	class="card edge-highlight shadow-sm mt-md flex flex-col gap-md p-md"
>
	<div class="flex flex-col gap-sm border-b border-hairline pb-md sm:flex-row sm:items-center sm:justify-between sm:gap-md">
		<div class="flex min-w-0 items-center gap-xs">
			<span
				data-save-dot
				class="size-2 animate-pop-in shrink-0 rounded-full bg-semantic-warning"
				aria-hidden="true"
				hidden
			></span>
			<p
				id="wizard-save-status"
				data-save-status
				role="status"
				class="min-w-0 break-words text-caption font-medium text-ink-subtle"
				hidden
			></p>
		</div>

		<button
			type="button"
			data-save-button
			aria-label={finalLabel}
			class="inline-flex w-full items-center justify-center gap-xs whitespace-nowrap rounded-md bg-primary px-md py-sm text-button font-medium text-on-primary transition-colors duration-200 hover:bg-primary-hover active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
		>
			<span data-save-button-label>{finalLabel}</span>
		</button>
	</div>

	<div class="flex flex-col gap-sm">
		<div class="flex items-center justify-center gap-xs">
			<span class="text-eyebrow font-medium uppercase tracking-tight text-ink-subtle">
				Progress
			</span>
			<span class="text-caption text-ink-tertiary" aria-hidden="true">·</span>
			<span class="text-caption font-medium text-ink" data-progress-percent>
				{percent}%
			</span>
		</div>

		<div
			role="progressbar"
			aria-label="Portfolio completion"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow={percent}
			aria-valuetext={percentLabel}
			class="h-2 w-full overflow-hidden rounded-full bg-surface-2"
		>
			<div
				class="h-full rounded-full bg-primary transition-[width] duration-300"
				data-progress-fill
				style={`width: ${percent}%`}
			></div>
		</div>
	</div>

	<p
		id="wizard-save-error"
		data-save-error
		role="alert"
		tabindex="-1"
		class="break-words rounded-md border border-semantic-danger/30 bg-surface-2 px-md py-sm text-caption font-medium text-semantic-danger"
		hidden
	></p>

	<div class="grid grid-cols-1 items-center gap-sm sm:grid-cols-[1fr_auto_1fr] sm:gap-md">
		<button
			type="button"
			data-nav="previous"
			hidden={isFirst}
			disabled={isFirst}
			aria-label={prevStep ? `Go to ${prevStep.title}` : 'Previous section'}
			class="inline-flex items-center justify-start gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-ink transition duration-200 hover:bg-surface-2 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 sm:col-start-1 sm:row-start-1 sm:justify-self-start"
		>
			<ArrowLeft size="16" aria-hidden="true" />
			<span class="flex min-w-0 flex-col items-start leading-tight">
				<span class="text-button font-medium text-ink">Previous</span>
				<span
					class="hidden max-w-full truncate text-caption text-ink-tertiary sm:block"
					data-prev-title
				>
					{prevStep?.title}
				</span>
			</span>
		</button>

		<div
			class="flex min-w-0 flex-col items-center justify-center text-center sm:col-start-2 sm:row-start-1"
		>
			<span class="truncate text-body-sm font-medium text-ink" data-step-number>
				Step {currentIndex + 1} of {TOTAL_STEPS}
			</span>
			<span class="hidden truncate text-caption text-ink-tertiary sm:block" data-step-title>
				{currentStep.title}
			</span>
		</div>

		<button
			type="button"
			data-nav={isLast ? 'save' : 'next'}
			disabled={false}
			aria-label={isLast ? finalLabel : nextStep ? `Go to ${nextStep.title}` : 'Next section'}
			class="inline-flex items-center justify-end gap-xs whitespace-nowrap rounded-md bg-primary px-md py-sm text-button font-medium text-on-primary transition duration-200 hover:bg-primary-hover active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 sm:col-start-3 sm:row-start-1 sm:justify-self-end"
		>
			<span class="flex min-w-0 flex-col items-end leading-tight">
				<span data-nav-label class="text-button font-medium text-on-primary">{finalLabel}</span>
				<span
					class="hidden max-w-full truncate text-caption text-on-primary/70 sm:block"
					data-next-title
					hidden={isLast}
				>
					{nextStep?.title}
				</span>
			</span>
			<ArrowRight size="16" aria-hidden="true" />
		</button>
	</div>
</nav>

<script>
	import { TOTAL_STEPS, WIZARD_STEPS, getBuilderProgress, wizardStore, createEmptyPortfolioData } from '../../lib/portfolio';
	import type { BuilderSaveSnapshot } from '../../lib/portfolio/builder-save-state';
	import { BuilderSaveTracker } from '../../lib/portfolio/builder-save-state';
	import { builderRecovery } from '../../lib/portfolio-builder/recovery';
	import {
		createPortfolioFromBuilder,
		portfolioManagerStore,
		portfolioOutputEquals,
		portfolioOutputToData,
		savePortfolioFromBuilder,
	} from '../../lib/portfolio-manager';

	const nav = document.getElementById('wizard-navigation');
	const editParamId = new URLSearchParams(window.location.search).get('portfolio');
	const editRecord = editParamId ? portfolioManagerStore.getPortfolio(editParamId) : undefined;
	const isEditMode = Boolean(editRecord);
	const finalLabel = isEditMode ? 'Save Changes' : 'Save Portfolio';
	let targetId = editParamId ?? '';

	// Baseline = the last persisted content. Edit mode uses the stored record
	// (so nothing is "unsaved" on a clean load, even when returning from a
	// builder preview), create mode starts from an empty portfolio.
	const saveState = new BuilderSaveTracker(
		editRecord ? portfolioOutputToData(editRecord.data) : createEmptyPortfolioData(),
		editRecord ? 'saved' : 'idle'
	);

	if (nav) {
		const prev = nav.querySelector<HTMLButtonElement>('[data-nav="previous"]');
		const next = nav.querySelector<HTMLButtonElement>('[data-nav="next"], [data-nav="save"]');
		const navLabel = nav.querySelector<HTMLElement>('[data-nav-label]');
		const prevTitle = nav.querySelector<HTMLElement>('[data-prev-title]');
		const nextTitle = nav.querySelector<HTMLElement>('[data-next-title]');
		const stepNumber = nav.querySelector<HTMLElement>('[data-step-number]');
		const stepTitle = nav.querySelector<HTMLElement>('[data-step-title]');
		const percentText = nav.querySelector<HTMLElement>('[data-progress-percent]');
		const progressbar = nav.querySelector<HTMLElement>('[role="progressbar"]');
		const fill = nav.querySelector<HTMLElement>('[data-progress-fill]');
		const saveStatus = nav.querySelector<HTMLElement>('[data-save-status]');
		const saveDot = nav.querySelector<HTMLElement>('[data-save-dot]');
		const saveError = nav.querySelector<HTMLElement>('[data-save-error]');
		const saveButton = nav.querySelector<HTMLButtonElement>('[data-save-button]');
		const saveButtonLabel = nav.querySelector<HTMLElement>('[data-save-button-label]');

		const showStatus = (message: string): void => {
			if (saveStatus) {
				saveStatus.textContent = message;
				saveStatus.hidden = false;
			}
		};

		const hideStatus = (): void => {
			if (saveStatus) {
				saveStatus.textContent = '';
				saveStatus.hidden = true;
			}
		};

		const showError = (message: string): void => {
			if (saveError) {
				saveError.textContent = message;
				saveError.hidden = false;
			}
		};

		const hideError = (): void => {
			if (saveError) {
				saveError.textContent = '';
				saveError.hidden = true;
			}
		};

		const navigateToSavedPortfolio = (): void => {
			window.setTimeout(() => {
				window.location.assign(
					`/preview?from=builder&portfolio=${encodeURIComponent(targetId)}`
				);
			}, 400);
		};

		/**
		 * The existing store persists synchronously but swallows storage write
		 * failures (a blocked/quota-exceeded localStorage still returns the
		 * in-memory record). Before reporting "Saved" we read the persisted
		 * collection back and confirm the current content actually landed, so
		 * a success message is never shown for a save that did not persist.
		 */
		const isSavePersisted = (id: string): boolean => {
			try {
				const raw = localStorage.getItem('portforge:portfolios:v1');
				if (!raw) return false;
				const parsed = JSON.parse(raw) as {
					records?: Array<{ id?: string; data?: unknown }>;
				};
				const current = portfolioManagerStore.getPortfolio(id);
				if (!current || !Array.isArray(parsed.records)) return false;
				const persisted = parsed.records.find((record) => record.id === id);
				if (!persisted) return false;
				return portfolioOutputEquals(
					current.data,
					persisted.data as Parameters<typeof portfolioOutputEquals>[0]
				);
			} catch {
				return false;
			}
		};

		/**
		 * Browser-level unsaved-change protection. Only armed while genuinely
		 * unsaved changes exist and no save is in flight; removed after a
		 * successful save so normal navigation is never blocked. Uses the
		 * native `beforeunload` prompt — no custom dialogs.
		 */
		const handleBeforeUnload = (event: BeforeUnloadEvent): void => {
			event.preventDefault();
		};

		const syncBeforeUnload = (snapshot: Readonly<BuilderSaveSnapshot>): void => {
			if (snapshot.dirty && snapshot.status !== 'saving') {
				window.addEventListener('beforeunload', handleBeforeUnload);
			} else {
				window.removeEventListener('beforeunload', handleBeforeUnload);
			}
		};

		const saveButtonLabelFor = (snapshot: Readonly<BuilderSaveSnapshot>): string => {
			if (snapshot.status === 'saving') return 'Saving…';
			if (snapshot.status === 'error') return 'Retry';
			if (snapshot.status === 'saved' && snapshot.message) return 'Saved';
			return finalLabel;
		};

		const saveButtonAriaFor = (snapshot: Readonly<BuilderSaveSnapshot>): string => {
			if (snapshot.status === 'saving') return 'Saving portfolio';
			if (snapshot.status === 'error') return 'Retry saving the portfolio';
			if (snapshot.status === 'saved' && snapshot.message) return 'Portfolio saved';
			return finalLabel;
		};

		/**
		 * Renders the save experience: an inline status line (role="status"),
		 * an amber dot for unsaved changes, a danger alert box for failures,
		 * and a single Save / Saving… / Saved / Retry button. Announcements
		 * only fire when the text actually changes, never on every keystroke.
		 */
		const renderSaveState = (): void => {
			const snapshot = saveState.getSnapshot();
			const isSaving = snapshot.status === 'saving';

			if (saveStatus) saveStatus.classList.remove('text-semantic-success');

			if (snapshot.status === 'error') {
				hideStatus();
				if (saveDot) saveDot.hidden = true;
				showError(snapshot.message ?? 'Could not save the portfolio. Please try again.');
			} else {
				hideError();
				if (isSaving) {
					showStatus('Saving…');
					if (saveDot) saveDot.hidden = true;
				} else if (snapshot.dirty) {
					showStatus('Unsaved changes');
					if (saveDot) saveDot.hidden = false;
				} else if (snapshot.status === 'saved') {
					showStatus(snapshot.message ?? 'No unsaved changes.');
					if (snapshot.message) saveStatus?.classList.add('text-semantic-success');
					if (saveDot) saveDot.hidden = true;
				} else {
					hideStatus();
					if (saveDot) saveDot.hidden = true;
				}
			}

			if (saveButton && saveButtonLabel) {
				saveButtonLabel.textContent = saveButtonLabelFor(snapshot);
				saveButton.setAttribute('aria-label', saveButtonAriaFor(snapshot));
				saveButton.disabled = isSaving;
				saveButton.setAttribute('aria-busy', String(isSaving));
			}

			syncBeforeUnload(snapshot);
		};

		const applyState = () => {
			const state = wizardStore.getState();
			const snapshot = saveState.getSnapshot();
			const isSaving = snapshot.status === 'saving';
			const index = WIZARD_STEPS.findIndex((step) => step.id === state.currentStep);
			const step = WIZARD_STEPS[Math.max(0, index)];
			const previousStep = WIZARD_STEPS[index - 1];
			const followingStep = WIZARD_STEPS[index + 1];

			const progress = getBuilderProgress(state.data);
			const percent = progress.percent;
			const percentLabel = `${progress.completed} of ${progress.total} sections complete (${percent}%)`;
			const isLast = index === WIZARD_STEPS.length - 1;

			if (prev) {
				prev.hidden = index === 0;
				prev.disabled = index === 0;
				if (previousStep) {
					prev.setAttribute('aria-label', `Go to ${previousStep.title}`);
				}
			}
			if (prevTitle) prevTitle.textContent = previousStep?.title ?? '';
			if (next) {
				next.dataset.nav = isLast ? 'save' : 'next';
				next.disabled = isSaving;
				if (followingStep) {
					next.setAttribute('aria-label', `Go to ${followingStep.title}`);
				} else {
					next.setAttribute('aria-label', saveButtonAriaFor(snapshot));
				}
			}
			if (nextTitle) {
				nextTitle.textContent = followingStep?.title ?? '';
				nextTitle.hidden = isLast;
			}
			if (navLabel) {
				navLabel.textContent = isLast
					? saveButtonLabelFor(snapshot)
					: 'Next';
			}
			if (saveButton) saveButton.hidden = isLast;
			if (stepNumber) stepNumber.textContent = `Step ${index + 1} of ${TOTAL_STEPS}`;
			if (stepTitle) stepTitle.textContent = step.title;
			if (percentText) percentText.textContent = `${percent}%`;
			if (progressbar) {
				progressbar.setAttribute('aria-valuenow', String(percent));
				progressbar.setAttribute('aria-valuetext', percentLabel);
			}
			if (fill) fill.style.width = `${percent}%`;
		};

		const performSave = (): void => {
			const snapshot = saveState.getSnapshot();
			if (snapshot.status === 'saving') return;

			// Once a portfolio exists (edit mode, or after the first create),
			// a save with no changes is a no-op: no update, no new version.
			if (targetId && !snapshot.dirty && snapshot.status !== 'error') {
				builderRecovery.markSaved(wizardStore.getState().data);
				saveState.note('No changes to save.');
				renderSaveState();
				return;
			}

			saveState.beginSave();
			renderSaveState();

			const fail = (message: string): void => {
				saveState.fail(message);
				renderSaveState();
				if (saveError) {
					// Re-announce a repeated failure to assistive tech.
					const wasSame = saveError.textContent === message;
					if (wasSame) {
						saveError.textContent = '';
						window.setTimeout(() => {
							if (saveError) saveError.textContent = message;
						}, 0);
					}
					saveError.focus();
				}
			};

			try {
				// Once a portfolio exists, saving always UPDATES it in place
				// (stable id preserved) — it never creates a duplicate.
				if (targetId) {
					const saved = savePortfolioFromBuilder(targetId, wizardStore.getState().data);
					if (!saved) {
						fail('Could not save changes. This portfolio may no longer exist.');
						return;
					}
				} else {
					const created = createPortfolioFromBuilder(wizardStore.getState().data);
					targetId = created.id;
				}
				if (!isSavePersisted(targetId)) {
					fail('Could not save the portfolio right now. Please try again.');
					return;
				}
saveState.completeSave(
					wizardStore.getState().data,
					isEditMode ? 'Changes saved.' : 'Portfolio saved.'
				);
				renderSaveState();
				builderRecovery.markSaved(wizardStore.getState().data);
				navigateToSavedPortfolio();
			} catch {
				fail('Could not save the portfolio. Please try again.');
			}
		};

		prev?.addEventListener('click', () => wizardStore.previous());
		next?.addEventListener('click', () => {
			if (next.dataset.nav === 'save') {
				performSave();
				return;
			}
			wizardStore.next();
		});
		saveButton?.addEventListener('click', performSave);

		const onWizardChange = () => {
			saveState.sync(wizardStore.getState().data);
			applyState();
			renderSaveState();
		};

		wizardStore.subscribe(onWizardChange);
		onWizardChange();
	}
</script>
