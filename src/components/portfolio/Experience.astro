---
import { Plus } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonSecondary, builderInputClass, builderPanelClass } from './builder-ui';

const employmentTypes = ['Full Time', 'Part Time', 'Internship', 'Freelance'];

const entries = wizardStore.getState().data.experience;
---

<BuilderSection
	id="experience"
	headingId="experience-heading"
	title="Experience"
	description="Show your internships, jobs and professional experience."
	stepNumber={3}
>
	<div class="flex flex-col gap-md">
		{
			entries.map((_, index) => (
				<div
					role="group"
					aria-label={`Experience ${index + 1}`}
					data-list-index={index}
					class={builderPanelClass}
				>
					<p
						data-entry-label
						data-entry-base="Experience"
						class="text-eyebrow font-medium uppercase tracking-tight text-ink-subtle"
					>
						Experience {index + 1}
					</p>

					<div class="grid grid-cols-1 gap-md md:grid-cols-2">
						<BuilderField id={`experience-job-title-${index}`} label="Job Title">
							<input
								id={`experience-job-title-${index}`}
								name="jobTitle"
								type="text"
								placeholder="Machine Learning Intern"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`experience-company-${index}`} label="Company">
							<input
								id={`experience-company-${index}`}
								name="company"
								type="text"
								placeholder="APSSDC"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`experience-employment-type-${index}`} label="Employment Type">
							<select
								id={`experience-employment-type-${index}`}
								name="employmentType"
								class={builderInputClass}
							>
								<option value="" disabled selected>
									Select an option
								</option>
								{employmentTypes.map((type) => <option value={type}>{type}</option>)}
							</select>
						</BuilderField>

						<BuilderField id={`experience-location-${index}`} label="Location">
							<input
								id={`experience-location-${index}`}
								name="location"
								type="text"
								placeholder="Guntur, Andhra Pradesh"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`experience-start-date-${index}`} label="Start Date">
							<input
								id={`experience-start-date-${index}`}
								name="startDate"
								type="month"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`experience-end-date-${index}`} label="End Date">
							<input
								id={`experience-end-date-${index}`}
								name="endDate"
								type="month"
								class={builderInputClass}
							/>
						</BuilderField>

						<label
							for={`experience-currently-working-${index}`}
							class="flex items-center gap-sm text-body-sm text-ink md:col-span-2"
						>
							<input
								id={`experience-currently-working-${index}`}
								name="currentlyWorking"
								type="checkbox"
								class="h-4 w-4 shrink-0 rounded accent-primary"
							/>
							<span>Currently Working Here</span>
						</label>

						<BuilderField
							id={`experience-description-${index}`}
							label="Description"
							className="md:col-span-2"
						>
							<textarea
								id={`experience-description-${index}`}
								name="description"
								rows="5"
								placeholder="Describe your responsibilities, achievements and technologies used..."
								class={builderInputClass}
							></textarea>
						</BuilderField>
					</div>
				</div>
			))
		}
	</div>

	<button type="button" data-add-entry slot="actions" class={builderButtonSecondary}>
		<Plus size="16" aria-hidden="true" />
		Add Another Experience
	</button>
</BuilderSection>
