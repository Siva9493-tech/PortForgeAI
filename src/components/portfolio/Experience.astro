---
import { Plus } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';

const inputClass =
	'w-full rounded-md border border-hairline bg-surface-2 px-md py-sm text-body text-ink transition-colors duration-200 placeholder:text-ink-tertiary focus:border-primary-focus focus:outline-none';

const employmentTypes = ['Full Time', 'Part Time', 'Internship', 'Freelance'];

const entries = wizardStore.getState().data.experience;
---

<section
	id="experience"
	aria-labelledby="experience-heading"
	class="mt-md flex flex-col gap-md"
>
	<div class="flex flex-col gap-xs">
		<h2 id="experience-heading" class="text-heading-md text-ink">
			Experience
		</h2>
		<p class="text-body-sm text-ink-subtle">
			Show your internships, jobs and professional experience.
		</p>
	</div>

	<div class="flex flex-col gap-md">
		{
			entries.map((_, index) => (
				<div
					role="group"
					aria-label={`Experience ${index + 1}`}
					data-list-index={index}
					class="grid grid-cols-1 gap-md md:grid-cols-2"
				>
					<div class="flex flex-col gap-xs">
						<label
							for={`experience-job-title-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							Job Title
						</label>
						<input
							id={`experience-job-title-${index}`}
							name="jobTitle"
							type="text"
							placeholder="Machine Learning Intern"
							class={inputClass}
						/>
					</div>

					<div class="flex flex-col gap-xs">
						<label
							for={`experience-company-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							Company
						</label>
						<input
							id={`experience-company-${index}`}
							name="company"
							type="text"
							placeholder="APSSDC"
							class={inputClass}
						/>
					</div>

					<div class="flex flex-col gap-xs">
						<label
							for={`experience-employment-type-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							Employment Type
						</label>
						<select
							id={`experience-employment-type-${index}`}
							name="employmentType"
							class={inputClass}
						>
							<option value="" disabled selected>
								Select an option
							</option>
							{employmentTypes.map((type) => <option value={type}>{type}</option>)}
						</select>
					</div>

					<div class="flex flex-col gap-xs">
						<label
							for={`experience-location-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							Location
						</label>
						<input
							id={`experience-location-${index}`}
							name="location"
							type="text"
							placeholder="Guntur, Andhra Pradesh"
							class={inputClass}
						/>
					</div>

					<div class="flex flex-col gap-xs">
						<label
							for={`experience-start-date-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							Start Date
						</label>
						<input
							id={`experience-start-date-${index}`}
							name="startDate"
							type="month"
							class={inputClass}
						/>
					</div>

					<div class="flex flex-col gap-xs">
						<label
							for={`experience-end-date-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							End Date
						</label>
						<input
							id={`experience-end-date-${index}`}
							name="endDate"
							type="month"
							class={inputClass}
						/>
					</div>

					<label
						for={`experience-currently-working-${index}`}
						class="flex items-center gap-sm text-body-sm text-ink md:col-span-2"
					>
						<input
							id={`experience-currently-working-${index}`}
							name="currentlyWorking"
							type="checkbox"
							class="h-4 w-4 shrink-0 accent-primary"
						/>
						<span>Currently Working Here</span>
					</label>

					<div class="flex flex-col gap-xs md:col-span-2">
						<label
							for={`experience-description-${index}`}
							class="text-body-sm font-medium text-ink-muted"
						>
							Description
						</label>
						<textarea
							id={`experience-description-${index}`}
							name="description"
							rows="5"
							placeholder="Describe your responsibilities, achievements and technologies used..."
							class={inputClass}
						></textarea>
					</div>
				</div>
			))
		}
	</div>

	<button
		type="button"
		data-add-entry
		class="inline-flex items-center justify-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-ink transition duration-200 hover:bg-surface-2 active:scale-[0.98]"
	>
		<Plus size="16" aria-hidden="true" />
		Add Another Experience
	</button>
</section>
