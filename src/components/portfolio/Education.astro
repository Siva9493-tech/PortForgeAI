---
import { Plus } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonSecondary, builderInputClass, builderPanelClass } from './builder-ui';

const entries = wizardStore.getState().data.education;
---

<BuilderSection
	id="education"
	headingId="education-heading"
	title="Education"
	description="Tell us about your academic background."
	stepNumber={2}
>
	<div class="flex flex-col gap-md">
		{
			entries.map((_, index) => (
				<div
					role="group"
					aria-label={`Education ${index + 1}`}
					data-list-index={index}
					class={builderPanelClass}
				>
					<p
						data-entry-label
						data-entry-base="Education"
						class="text-eyebrow font-medium uppercase tracking-tight text-ink-subtle"
					>
						Education {index + 1}
					</p>

					<div class="grid grid-cols-1 gap-md md:grid-cols-2">
						<BuilderField id={`education-degree-${index}`} label="Degree">
							<input
								id={`education-degree-${index}`}
								name="degree"
								type="text"
								placeholder="Bachelor of Technology"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-institution-${index}`} label="Institution">
							<input
								id={`education-institution-${index}`}
								name="institution"
								type="text"
								placeholder="Vasireddy Venkatadri Institute of Technology"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-field-of-study-${index}`} label="Field of Study">
							<input
								id={`education-field-of-study-${index}`}
								name="fieldOfStudy"
								type="text"
								placeholder="Computer Science and Engineering (AI & ML)"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-start-year-${index}`} label="Start Year">
							<input
								id={`education-start-year-${index}`}
								name="startYear"
								type="number"
								placeholder="2023"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-end-year-${index}`} label="End Year">
							<input
								id={`education-end-year-${index}`}
								name="endYear"
								type="number"
								placeholder="2027"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-cgpa-${index}`} label="CGPA / Percentage">
							<input
								id={`education-cgpa-${index}`}
								name="cgpa"
								type="text"
								placeholder="8.9 CGPA"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField
							id={`education-description-${index}`}
							label="Description"
							className="md:col-span-2"
						>
							<textarea
								id={`education-description-${index}`}
								name="description"
								rows="4"
								placeholder="Write achievements, coursework or academic highlights..."
								class={builderInputClass}
							></textarea>
						</BuilderField>
					</div>
				</div>
			))
		}
	</div>

	<button type="button" data-add-entry slot="actions" class={builderButtonSecondary}>
		<Plus size="16" aria-hidden="true" />
		Add Another Education
	</button>
</BuilderSection>
