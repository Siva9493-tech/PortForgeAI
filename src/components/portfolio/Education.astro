---
import { GraduationCap } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderEntryPanel from './BuilderEntryPanel.astro';
import BuilderField from './BuilderField.astro';
import BuilderRepeatedList from './BuilderRepeatedList.astro';
import BuilderSection from './BuilderSection.astro';
import BuilderSuggestions from './BuilderSuggestions.astro';
import { builderInputClass, builderTextareaClass } from './builder-ui';

const entries = wizardStore.getState().data.education;
---

<BuilderSection
	id="education"
	headingId="education-heading"
	title="Education"
	description="Tell us about your academic background."
	stepNumber={2}
>
	<BuilderRepeatedList
		itemsCount={entries.length}
		emptyTitle="No education added yet"
		emptyHint="Education shows the academic background and formal training behind your skills."
		emptyGuidance="Include the degree, institution, dates attended, and any relevant coursework or highlights."
		addLabel="Add Education"
		addAnotherLabel="Add Another Education"
		addHintComplete="Add another entry to show more of your academic background."
		addHintIncomplete="Add the degree and institution to complete this section."
		emptyIcon={GraduationCap}
	>
		{
			entries.map((_, index) => (
				<BuilderEntryPanel entryBase="Education" index={index}>
					<BuilderField id={`education-degree-${index}`} label="Degree">
							<input
								id={`education-degree-${index}`}
								name="degree"
								type="text"
								placeholder="Bachelor of Technology"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-institution-${index}`} label="Institution">
							<input
								id={`education-institution-${index}`}
								name="institution"
								type="text"
								placeholder="Vasireddy Venkatadri Institute of Technology"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`education-field-of-study-${index}`} label="Field of Study">
							<input
								id={`education-field-of-study-${index}`}
								name="fieldOfStudy"
								type="text"
								placeholder="Computer Science and Engineering (AI & ML)"
								class={builderInputClass}
							/>
						</BuilderField>

						<div class="grid grid-cols-2 gap-md">
							<BuilderField id={`education-start-year-${index}`} label="Start Year">
								<input
									id={`education-start-year-${index}`}
									name="startYear"
									type="number"
									placeholder="2023"
									class={builderInputClass}
								/>
							</BuilderField>

							<BuilderField id={`education-end-year-${index}`} label="End Year">
								<input
									id={`education-end-year-${index}`}
									name="endYear"
									type="number"
									placeholder="2027"
									class={builderInputClass}
								/>
							</BuilderField>
						</div>

						<BuilderField id={`education-cgpa-${index}`} label="CGPA / Percentage">
							<input
								id={`education-cgpa-${index}`}
								name="cgpa"
								type="text"
								placeholder="8.9 CGPA"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField
							id={`education-description-${index}`}
							label="Description"
							className="md:col-span-2"
							hint="Mention achievements, coursework or academic highlights."
						>
							<textarea
								id={`education-description-${index}`}
								name="description"
								rows="4"
								placeholder="Describe coursework, projects or academic highlights..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>
				</BuilderEntryPanel>
			))
		}

		<template slot="template">
			<BuilderEntryPanel entryBase="Education" index={0}>
				<BuilderField id="education-degree-template" label="Degree">
						<input
						id="education-degree-template"
						name="degree"
						type="text"
						placeholder="Bachelor of Technology"
						class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField id="education-institution-template" label="Institution">
						<input
						id="education-institution-template"
						name="institution"
						type="text"
						placeholder="Vasireddy Venkatadri Institute of Technology"
						class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField id="education-field-of-study-template" label="Field of Study">
						<input
						id="education-field-of-study-template"
						name="fieldOfStudy"
						type="text"
						placeholder="Computer Science and Engineering (AI & ML)"
						class={builderInputClass}
						/>
					</BuilderField>

					<div class="grid grid-cols-2 gap-md">
						<BuilderField id="education-start-year-template" label="Start Year">
							<input
						id="education-start-year-template"
						name="startYear"
						type="number"
						placeholder="2023"
						class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id="education-end-year-template" label="End Year">
							<input
						id="education-end-year-template"
						name="endYear"
						type="number"
						placeholder="2027"
						class={builderInputClass}
							/>
						</BuilderField>
					</div>

					<BuilderField id="education-cgpa-template" label="CGPA / Percentage">
						<input
							id="education-cgpa-template"
							name="cgpa"
							type="text"
							placeholder="8.9 CGPA"
							class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField
						id="education-description-template"
						label="Description"
						className="md:col-span-2"
						hint="Mention achievements, coursework or academic highlights."
					>
						<textarea
							id="education-description-template"
							name="description"
							rows="4"
							placeholder="Describe coursework, projects or academic highlights..."
							class={builderTextareaClass}
						></textarea>
</BuilderField>
				</BuilderEntryPanel>
			</template>
		</BuilderRepeatedList>

		<BuilderSuggestions section="education" />
</BuilderSection>
