---
import { ArrowUpRight, Copy, Download, History, Pencil, Rocket, Trash2 } from 'lucide-astro';
import type { PortfolioRecord } from '../../lib/portfolio-manager';
import {
	formatPortfolioDate,
	portfolioStatusText,
	portfolioStatusTone,
} from '../../lib/portfolio-manager';

interface Props {
	portfolio: PortfolioRecord;
}

const { portfolio } = Astro.props;

const tone = portfolioStatusTone(portfolio.status);
const titleId = `portfolio-card-title-${portfolio.id}`;

const secondaryButtonClass =
	'inline-flex items-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-ink transition-colors duration-200 hover:bg-surface-2';

const publishButtonClass =
	'inline-flex w-full items-center justify-center gap-xs rounded-md bg-primary px-md py-sm text-button font-medium text-on-primary transition-colors duration-200 hover:bg-primary-hover';

const duplicateButtonClass =
	'inline-flex w-full items-center justify-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-ink transition-colors duration-200 hover:bg-surface-2';

const deleteButtonClass =
	'inline-flex items-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-semantic-danger transition-colors duration-200 hover:bg-surface-2';

const historyButtonClass =
	'inline-flex w-full items-center justify-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-ink transition-colors duration-200 hover:bg-surface-2';

const exportButtonClass =
	'inline-flex w-full items-center justify-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-sm text-button font-medium text-ink transition-colors duration-200 hover:bg-surface-2';
---

<article class="card flex flex-col p-md" aria-labelledby={titleId}>
	<div class="flex items-start justify-between gap-sm">
		<h3 id={titleId} class="truncate text-body font-semibold text-ink">
			{portfolio.title}
		</h3>
		<span
			class="inline-flex shrink-0 items-center gap-xs rounded-pill border border-hairline bg-surface-2 px-xs py-xs"
		>
			<span class={`h-1.5 w-1.5 shrink-0 rounded-full ${tone.dot}`} aria-hidden="true"></span>
			<span class={`text-caption font-medium ${tone.label}`}>
				{portfolioStatusText(portfolio.status)}
			</span>
		</span>
	</div>

	<dl class="mt-md flex flex-col gap-xs">
		<div class="flex items-center justify-between gap-sm">
			<dt class="text-caption text-ink-subtle">Last updated</dt>
			<dd class="text-caption font-medium text-ink">{formatPortfolioDate(portfolio.updatedAt)}</dd>
		</div>
		<div class="flex items-center justify-between gap-sm">
			<dt class="text-caption text-ink-subtle">Version</dt>
			<dd class="text-caption font-medium text-ink">v{portfolio.currentVersion}</dd>
		</div>
	</dl>

	<div
		class="mt-md flex grow flex-col gap-sm rounded-b-md border-t border-hairline pt-sm"
	>
		{
			portfolio.status === 'draft' && (
				<button
					type="button"
					data-publish-portfolio={portfolio.id}
					aria-label={`Publish ${portfolio.title}`}
					class={publishButtonClass}
				>
					<Rocket size="14" aria-hidden="true" />
					Publish
				</button>
			)
		}
		<button
			type="button"
			data-duplicate-portfolio={portfolio.id}
			aria-label={`Duplicate ${portfolio.title}`}
			class={duplicateButtonClass}
		>
			<Copy size="14" aria-hidden="true" />
			Duplicate
		</button>
		<button
			type="button"
			data-history-portfolio={portfolio.id}
			aria-label={`View version history for ${portfolio.title}`}
			class={historyButtonClass}
		>
			<History size="14" aria-hidden="true" />
			Version History
		</button>
		<button
			type="button"
			data-export-portfolio={portfolio.id}
			aria-label={`Export ${portfolio.title}`}
			class={exportButtonClass}
		>
			<Download size="14" aria-hidden="true" />
			Export
		</button>
		<div class="flex flex-wrap gap-sm">
			<a
				href={`/portfolio-builder?portfolio=${portfolio.id}`}
				aria-label={`Edit ${portfolio.title}`}
				class={`${secondaryButtonClass} flex-1 justify-center`}
			>
				<Pencil size="14" aria-hidden="true" />
				Edit
			</a>
			<a
				href={`/preview?portfolio=${portfolio.id}`}
				aria-label={`Open ${portfolio.title}`}
				class={`${secondaryButtonClass} flex-1 justify-center`}
			>
				Open
				<ArrowUpRight size="14" class="text-ink-subtle" aria-hidden="true" />
			</a>
			<button
				type="button"
				data-delete-portfolio={portfolio.id}
				aria-label={`Delete ${portfolio.title}`}
				class={`${deleteButtonClass} flex-1 justify-center`}
			>
				<Trash2 size="14" aria-hidden="true" />
				Delete
			</button>
		</div>
	</div>
</article>