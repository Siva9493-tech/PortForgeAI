---
import '../../styles/globals.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Portfolio Builder — PortForge AI',
	description = 'Create your professional portfolio with the PortForge AI guided builder.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#010102" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<a
			href="#portfolio-builder-main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface-2 focus:px-sm focus:py-xs focus:text-body-sm focus:text-ink"
		>
			Skip to content
		</a>

		<div class="flex h-dvh flex-col overflow-hidden">
			<header
				class="flex h-14 shrink-0 items-center justify-between gap-md border-b border-hairline px-md md:px-xl"
				aria-label="Portfolio builder header"
			>
				<div class="flex min-w-0 flex-col">
					<span class="truncate text-body font-semibold text-ink">Portfolio Builder</span>
					<span class="hidden truncate text-caption text-ink-tertiary sm:block">
						Create your professional portfolio
					</span>
				</div>
				<a
					href="/portfolios"
					class="inline-flex shrink-0 items-center gap-xs rounded-md border border-hairline bg-surface-1 px-md py-xs text-button font-medium text-ink transition-colors duration-200 hover:bg-surface-2"
				>
					My Portfolios
				</a>
			</header>

			<main
				id="portfolio-builder-main"
				tabindex="-1"
				aria-label="Portfolio builder workspace"
				class="flex-1 overflow-y-auto"
			>
				<div class="w-full p-md md:p-xl">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>
