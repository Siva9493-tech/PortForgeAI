---
import { CheckCircle2, Linkedin } from 'lucide-astro';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonPrimary, builderInputClass, builderPanelClass } from './builder-ui';

const importModes = [
	'Import Everything',
	'Import Experience Only',
	'Import Education Only',
	'Import Skills Only',
	'Custom Import',
];

const connectPanelClass =
	'flex flex-col items-center gap-sm rounded-md border border-hairline bg-surface-2 p-xl text-center';
---

<BuilderSection
	id="linkedin-import"
	headingId="linkedin-import-heading"
	title="LinkedIn Import"
	description="Connect your LinkedIn profile to automatically generate professional portfolio content in the future."
	stepNumber={11}
>
	<form novalidate class="grid grid-cols-1 gap-md md:grid-cols-2">
		<BuilderField id="linkedin-profile-url" label="LinkedIn Profile URL">
			<input
				id="linkedin-profile-url"
				name="linkedinProfileUrl"
				type="url"
				placeholder="https://linkedin.com/in/yourname"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="import-mode" label="Import Mode">
			<select id="import-mode" name="importMode" class={builderInputClass}>
				<option value="" disabled selected>
					Select an import mode
				</option>
				{importModes.map((mode) => <option value={mode}>{mode}</option>)}
			</select>
		</BuilderField>
	</form>

	<div class="mx-auto w-full max-w-narrow">
		<div class={connectPanelClass}>
			<span
				class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-surface-2 text-ink-subtle"
				aria-hidden="true"
			>
				<Linkedin size="22" />
			</span>

			<p class="text-card-title text-ink">Connect LinkedIn</p>
			<p class="max-w-prose text-body text-ink-muted">
				Future versions will securely import your professional profile, work experience and
				skills.
			</p>

			<button
				type="button"
				disabled
				class={`${builderButtonPrimary} mt-2`}
			>
				Connect LinkedIn
			</button>
		</div>
	</div>

	<div class={builderPanelClass}>
		<h3 class="text-card-title text-ink">What will be imported?</h3>
		<ul class="flex list-disc flex-col gap-xs pl-4 text-body-sm text-ink-muted marker:text-ink-subtle">
			<li>Professional headline</li>
			<li>Work experience</li>
			<li>Education</li>
			<li>Skills</li>
			<li>Certifications</li>
			<li>Profile summary</li>
		</ul>
	</div>

	<div class="flex flex-col items-start gap-xs rounded-md border border-semantic-success/25 bg-surface-2 p-md">
		<div class="flex items-center gap-xs">
			<CheckCircle2 size="18" class="shrink-0 text-semantic-success" aria-hidden="true" />
			<h3 class="text-card-title text-ink">Portfolio Builder Complete</h3>
		</div>
		<p class="text-body-sm text-ink-muted">
			Your portfolio information is ready. Generate your portfolio to continue.
		</p>
	</div>
</BuilderSection>
