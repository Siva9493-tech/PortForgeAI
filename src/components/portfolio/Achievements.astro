---
import { Plus } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonSecondary, builderInputClass, builderPanelClass } from './builder-ui';

const categories = [
	'Award',
	'Hackathon',
	'Competition',
	'Research',
	'Leadership',
	'Open Source',
	'Other',
];

const entries = wizardStore.getState().data.achievements;
---

<BuilderSection
	id="achievements"
	headingId="achievements-heading"
	title="Achievements"
	description="Highlight your awards, accomplishments and recognitions."
	stepNumber={7}
>
	<div class="flex flex-col gap-md">
		{
			entries.map((_, index) => (
				<div
					role="group"
					aria-label={`Achievement ${index + 1}`}
					data-list-index={index}
					class={builderPanelClass}
				>
					<p
						data-entry-label
						data-entry-base="Achievement"
						class="text-eyebrow font-medium uppercase tracking-tight text-ink-subtle"
					>
						Achievement {index + 1}
					</p>

					<div class="grid grid-cols-1 gap-md md:grid-cols-2">
						<BuilderField id={`achievement-title-${index}`} label="Achievement Title">
							<input
								id={`achievement-title-${index}`}
								name="achievementTitle"
								type="text"
								placeholder="Winner — Smart India Hackathon"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`achievement-organization-${index}`} label="Organization">
							<input
								id={`achievement-organization-${index}`}
								name="organization"
								type="text"
								placeholder="Government of India"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`achievement-date-${index}`} label="Achievement Date">
							<input
								id={`achievement-date-${index}`}
								name="achievementDate"
								type="month"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`achievement-category-${index}`} label="Achievement Category">
							<select
								id={`achievement-category-${index}`}
								name="category"
								class={builderInputClass}
							>
								<option value="" disabled selected>
									Select a category
								</option>
								{categories.map((category) => <option value={category}>{category}</option>)}
							</select>
						</BuilderField>

						<BuilderField
							id={`achievement-description-${index}`}
							label="Description"
							className="md:col-span-2"
						>
							<textarea
								id={`achievement-description-${index}`}
								name="description"
								rows="5"
								placeholder="Describe your achievement and its impact..."
								class={builderInputClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id={`achievement-supporting-link-${index}`}
							label="Supporting Link"
							className="md:col-span-2"
						>
							<input
								id={`achievement-supporting-link-${index}`}
								name="supportingLink"
								type="url"
								placeholder="https://..."
								class={builderInputClass}
							/>
						</BuilderField>
					</div>
				</div>
			))
		}
	</div>

	<button type="button" data-add-entry slot="actions" class={builderButtonSecondary}>
		<Plus size="16" aria-hidden="true" />
		Add Another Achievement
	</button>
</BuilderSection>
