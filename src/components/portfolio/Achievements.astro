---
import { Link2, Trophy } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderEntryPanel from './BuilderEntryPanel.astro';
import BuilderField from './BuilderField.astro';
import BuilderRepeatedList from './BuilderRepeatedList.astro';
import BuilderSection from './BuilderSection.astro';
import BuilderSuggestions from './BuilderSuggestions.astro';
import {
	builderInputClass,
	builderInputWithIconClass,
	builderTextareaClass,
} from './builder-ui';

const categories = [
	'Award',
	'Hackathon',
	'Competition',
	'Research',
	'Leadership',
	'Open Source',
	'Other',
];

const entries = wizardStore.getState().data.achievements;
---

<BuilderSection
	id="achievements"
	headingId="achievements-heading"
	title="Achievements"
	description="Highlight your awards, accomplishments and recognitions."
	stepNumber={7}
>
	<BuilderRepeatedList
		itemsCount={entries.length}
		emptyTitle="No achievements added yet"
		emptyHint="Meaningful accomplishments strengthen your credibility beyond your job title."
		emptyGuidance="Include the achievement, the organization, a date, and what it meant."
		addLabel="Add Achievement"
		addAnotherLabel="Add Another Achievement"
		addHintComplete="Add another achievement to highlight more of your impact."
		addHintIncomplete="Add the achievement title to complete this section."
		emptyIcon={Trophy}
	>
		{
			entries.map((_, index) => (
				<BuilderEntryPanel entryBase="Achievement" index={index}>
					<BuilderField id={`achievement-title-${index}`} label="Achievement Title">
							<input
								id={`achievement-title-${index}`}
								name="achievementTitle"
								type="text"
								placeholder="Winner — Smart India Hackathon"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`achievement-organization-${index}`} label="Organization">
							<input
								id={`achievement-organization-${index}`}
								name="organization"
								type="text"
								placeholder="Government of India"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`achievement-date-${index}`} label="Achievement Date">
							<input
								id={`achievement-date-${index}`}
								name="achievementDate"
								type="month"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`achievement-category-${index}`} label="Achievement Category">
							<select
								id={`achievement-category-${index}`}
								name="category"
								class={builderInputClass}
							>
								<option value="" disabled selected>
									Select a category
								</option>
								{categories.map((category) => <option value={category}>{category}</option>)}
							</select>
						</BuilderField>

						<BuilderField
							id={`achievement-description-${index}`}
							label="Description"
							className="md:col-span-2"
							hint="Describe your achievement and its impact."
						>
							<textarea
								id={`achievement-description-${index}`}
								name="description"
								rows="5"
								placeholder="Describe your achievement and its impact..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id={`achievement-supporting-link-${index}`}
							label="Supporting Link"
							className="md:col-span-2"
							icon={Link2}
						>
							<input
								id={`achievement-supporting-link-${index}`}
								name="supportingLink"
								type="url"
								placeholder="https://..."
								class={builderInputWithIconClass}
							/>
						</BuilderField>
				</BuilderEntryPanel>
			))
		}

		<template slot="template">
			<BuilderEntryPanel entryBase="Achievement" index={0}>
				<BuilderField id="achievement-title-template" label="Achievement Title">
						<input
						id="achievement-title-template"
						name="achievementTitle"
						type="text"
						placeholder="Winner — Smart India Hackathon"
						class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField id="achievement-organization-template" label="Organization">
						<input
						id="achievement-organization-template"
						name="organization"
						type="text"
						placeholder="Government of India"
						class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField id="achievement-date-template" label="Achievement Date">
						<input
							id="achievement-date-template"
							name="achievementDate"
							type="month"
							class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField id="achievement-category-template" label="Achievement Category">
						<select
							id="achievement-category-template"
							name="category"
							class={builderInputClass}
						>
							<option value="" disabled selected>
								Select a category
							</option>
							{categories.map((category) => <option value={category}>{category}</option>)}
						</select>
					</BuilderField>

					<BuilderField
						id="achievement-description-template"
						label="Description"
						className="md:col-span-2"
						hint="Describe your achievement and its impact."
					>
						<textarea
							id="achievement-description-template"
							name="description"
							rows="5"
							placeholder="Describe your achievement and its impact..."
							class={builderTextareaClass}
						></textarea>
					</BuilderField>

					<BuilderField
						id="achievement-supporting-link-template"
						label="Supporting Link"
						className="md:col-span-2"
						icon={Link2}
					>
						<input
							id="achievement-supporting-link-template"
							name="supportingLink"
							type="url"
							placeholder="https://..."
							class={builderInputWithIconClass}
						/>
</BuilderField>
				</BuilderEntryPanel>
			</template>
		</BuilderRepeatedList>

		<BuilderSuggestions section="achievements" />
</BuilderSection>
