---
import { Plus } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonSecondary, builderInputClass, builderPanelClass } from './builder-ui';

const entries = wizardStore.getState().data.projects;
---

<BuilderSection
	id="projects"
	headingId="projects-heading"
	title="Projects"
	description="Showcase your best technical projects."
	stepNumber={4}
>
	<div class="flex flex-col gap-md">
		{
			entries.map((_, index) => (
				<div
					role="group"
					aria-label={`Project ${index + 1}`}
					data-list-index={index}
					class={builderPanelClass}
				>
					<p
						data-entry-label
						data-entry-base="Project"
						class="text-eyebrow font-medium uppercase tracking-tight text-ink-subtle"
					>
						Project {index + 1}
					</p>

					<div class="grid grid-cols-1 gap-md md:grid-cols-2">
						<BuilderField id={`project-name-${index}`} label="Project Name">
							<input
								id={`project-name-${index}`}
								name="projectName"
								type="text"
								placeholder="PortForge AI"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`project-role-${index}`} label="Project Role">
							<input
								id={`project-role-${index}`}
								name="projectRole"
								type="text"
								placeholder="Full Stack Developer"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField
							id={`project-technologies-${index}`}
							label="Technologies Used"
							className="md:col-span-2"
						>
							<input
								id={`project-technologies-${index}`}
								name="technologies"
								type="text"
								placeholder="Astro, TypeScript, Tailwind CSS, Supabase"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`project-github-url-${index}`} label="GitHub Repository">
							<input
								id={`project-github-url-${index}`}
								name="githubUrl"
								type="url"
								placeholder="https://github.com/username/project"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`project-demo-url-${index}`} label="Live Demo URL">
							<input
								id={`project-demo-url-${index}`}
								name="demoUrl"
								type="url"
								placeholder="https://project.vercel.app"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField
							id={`project-description-${index}`}
							label="Project Description"
							className="md:col-span-2"
						>
							<textarea
								id={`project-description-${index}`}
								name="description"
								rows="6"
								placeholder="Describe the project, your contributions, features, and impact..."
								class={builderInputClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id={`project-key-highlights-${index}`}
							label="Key Highlights"
							className="md:col-span-2"
						>
							<textarea
								id={`project-key-highlights-${index}`}
								name="highlights"
								rows="4"
								placeholder="Mention important achievements or results..."
								class={builderInputClass}
							></textarea>
						</BuilderField>
					</div>
				</div>
			))
		}
	</div>

	<button type="button" data-add-entry slot="actions" class={builderButtonSecondary}>
		<Plus size="16" aria-hidden="true" />
		Add Another Project
	</button>
</BuilderSection>
