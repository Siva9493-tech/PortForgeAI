---
import { Folder, Link2 } from 'lucide-astro';
import { wizardStore } from '../../lib/portfolio';
import BuilderEntryPanel from './BuilderEntryPanel.astro';
import BuilderField from './BuilderField.astro';
import BuilderRepeatedList from './BuilderRepeatedList.astro';
import BuilderSection from './BuilderSection.astro';
import BuilderSuggestions from './BuilderSuggestions.astro';
import {
	builderInputClass,
	builderInputWithIconClass,
	builderTextareaClass,
} from './builder-ui';

const entries = wizardStore.getState().data.projects;
---

<BuilderSection
	id="projects"
	headingId="projects-heading"
	title="Projects"
	description="Showcase your best technical projects."
	stepNumber={4}
>
	<BuilderRepeatedList
		itemsCount={entries.length}
		emptyTitle="No projects added yet"
		emptyHint="Projects demonstrate your practical ability and problem-solving in action."
		emptyGuidance="Start with your strongest project — include what you built, the technologies used, and the result."
		addLabel="Add Project"
		addAnotherLabel="Add Another Project"
		addHintComplete="Add another project to show more of your practical work."
		addHintIncomplete="Add a project name to complete this section."
		emptyIcon={Folder}
	>
		{
			entries.map((_, index) => (
				<BuilderEntryPanel entryBase="Project" index={index}>
					<BuilderField id={`project-name-${index}`} label="Project Name">
							<input
								id={`project-name-${index}`}
								name="projectName"
								type="text"
								placeholder="PortForge AI"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField id={`project-role-${index}`} label="Project Role">
							<input
								id={`project-role-${index}`}
								name="projectRole"
								type="text"
								placeholder="Full Stack Developer"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField
							id={`project-technologies-${index}`}
							label="Technologies Used"
							className="md:col-span-2"
							hint="Separate multiple technologies with commas."
						>
							<input
								id={`project-technologies-${index}`}
								name="technologies"
								type="text"
								placeholder="Astro, TypeScript, Tailwind CSS, Supabase"
								class={builderInputClass}
							/>
						</BuilderField>

						<BuilderField
							id={`project-github-url-${index}`}
							label="GitHub Repository"
							icon={Link2}
						>
							<input
								id={`project-github-url-${index}`}
								name="githubUrl"
								type="url"
								placeholder="https://github.com/username/project"
								class={builderInputWithIconClass}
							/>
						</BuilderField>

						<BuilderField
							id={`project-demo-url-${index}`}
							label="Live Demo URL"
							icon={Link2}
						>
							<input
								id={`project-demo-url-${index}`}
								name="demoUrl"
								type="url"
								placeholder="https://project.vercel.app"
								class={builderInputWithIconClass}
							/>
						</BuilderField>

						<BuilderField
							id={`project-description-${index}`}
							label="Project Description"
							className="md:col-span-2"
							hint="Describe the project, your contributions, features, and impact."
						>
							<textarea
								id={`project-description-${index}`}
								name="description"
								rows="6"
								placeholder="Describe the project, your contributions, features, and impact..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id={`project-key-highlights-${index}`}
							label="Key Highlights"
							className="md:col-span-2"
							hint="One highlight per line."
						>
							<textarea
								id={`project-key-highlights-${index}`}
								name="highlights"
								rows="4"
								placeholder="Mention important achievements or results, one per line..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>
				</BuilderEntryPanel>
			))
		}

		<template slot="template">
			<BuilderEntryPanel entryBase="Project" index={0}>
				<BuilderField id="project-name-template" label="Project Name">
						<input
						id="project-name-template"
						name="projectName"
						type="text"
						placeholder="PortForge AI"
						class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField id="project-role-template" label="Project Role">
						<input
						id="project-role-template"
						name="projectRole"
						type="text"
						placeholder="Full Stack Developer"
						class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField
						id="project-technologies-template"
						label="Technologies Used"
						className="md:col-span-2"
						hint="Separate multiple technologies with commas."
					>
						<input
							id="project-technologies-template"
							name="technologies"
							type="text"
							placeholder="Astro, TypeScript, Tailwind CSS, Supabase"
							class={builderInputClass}
						/>
					</BuilderField>

					<BuilderField
						id="project-github-url-template"
						label="GitHub Repository"
						icon={Link2}
					>
						<input
						id="project-github-url-template"
						name="githubUrl"
						type="url"
						placeholder="https://github.com/username/project"
						class={builderInputWithIconClass}
						/>
					</BuilderField>

					<BuilderField id="project-demo-url-template" label="Live Demo URL" icon={Link2}>
						<input
							id="project-demo-url-template"
							name="demoUrl"
							type="url"
							placeholder="https://project.vercel.app"
							class={builderInputWithIconClass}
						/>
					</BuilderField>

					<BuilderField
						id="project-description-template"
						label="Project Description"
						className="md:col-span-2"
						hint="Describe the project, your contributions, features, and impact."
					>
						<textarea
							id="project-description-template"
							name="description"
							rows="6"
							placeholder="Describe the project, your contributions, features, and impact..."
							class={builderTextareaClass}
						></textarea>
					</BuilderField>

					<BuilderField
						id="project-key-highlights-template"
						label="Key Highlights"
						className="md:col-span-2"
						hint="One highlight per line."
					>
						<textarea
							id="project-key-highlights-template"
							name="highlights"
							rows="4"
							placeholder="Mention important achievements or results, one per line..."
							class={builderTextareaClass}
						></textarea>
					</BuilderField>
				</BuilderEntryPanel>
			</template>
		</BuilderRepeatedList>

		<BuilderSuggestions section="projects" />
</BuilderSection>
