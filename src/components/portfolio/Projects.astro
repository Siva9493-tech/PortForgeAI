						placeholder="https://github.com/username/project"
						class={builderInputWithIconClass}
					/>
				</BuilderField>

				<BuilderField id="project-demo-url-template" label="Live Demo URL" icon={Link2}>
					<input
						id="project-demo-url-template"
						name="demoUrl"
						type="url"
						placeholder="https://project.vercel.app"
						class={builderInputWithIconClass}
					/>
				</BuilderField>

				<!-- Professional Case Study (Progressive Disclosure) -->
				<details class="group col-span-1 md:col-span-2 rounded-lg border border-hairline bg-surface-1/60 p-md transition-colors hover:border-hairline-strong">
					<summary class="flex cursor-pointer list-none items-center justify-between text-caption font-semibold text-ink select-none">
						<span class="flex flex-wrap items-center gap-xs">
							<BookOpen size="16" class="text-accent" aria-hidden="true" />
							<span>Professional Case Study</span>
							<span class="text-ink-tertiary text-xs font-normal">(Optional — Problem, Solution, Architecture, Outcomes)</span>
						</span>
						<ChevronDown size="16" class="text-ink-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
					</summary>
					<div class="mt-md grid grid-cols-1 gap-md border-t border-hairline-subtle pt-md md:grid-cols-2">
						<BuilderField
							id="project-problem-template"
							label="What was the core problem?"
							hint="What problem, pain point, or goal did you set out to solve?"
						>
							<textarea
								id="project-problem-template"
								name="problem"
								rows="3"
								placeholder="Describe the initial problem or inefficiency..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id="project-why-it-mattered-template"
							label="Why did this project matter?"
							hint="Why was solving this important to users, stakeholders, or your learning?"
						>
							<textarea
								id="project-why-it-mattered-template"
								name="whyItMattered"
								rows="3"
								placeholder="Explain why solving this was valuable..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id="project-solution-template"
							label="What was your solution?"
							hint="What did you design or build to address the problem?"
						>
							<textarea
								id="project-solution-template"
								name="solution"
								rows="3"
								placeholder="Describe the solution built..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id="project-how-it-was-built-template"
							label="How did you build it?"
							hint="Key architecture, frameworks, database choices, or engineering patterns."
						>
							<textarea
								id="project-how-it-was-built-template"
								name="howItWasBuilt"
								rows="3"
								placeholder="Technical implementation details, architecture, trade-offs..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id="project-challenges-template"
							label="What was technically difficult?"
							hint="Obstacles, trade-offs, or tricky bugs you had to overcome."
						>
							<textarea
								id="project-challenges-template"
								name="challenges"
								rows="3"
								placeholder="Key technical hurdles encountered..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>

						<BuilderField
							id="project-results-template"
							label="What was the outcome or impact?"
							hint="Real outcomes (e.g. deployed to Vercel, tested with users, completed MVP)."
						>
							<textarea
								id="project-results-template"
								name="results"
								rows="3"
								placeholder="Document actual outcomes (completed prototype, deployed live, validated with users)..."
								class={builderTextareaClass}
							></textarea>
						</BuilderField>
					</div>
				</details>

				<!-- Media & Screenshots (Progressive Disclosure) -->
				<details class="group col-span-1 md:col-span-2 rounded-lg border border-hairline bg-surface-1/60 p-md transition-colors hover:border-hairline-strong">
					<summary class="flex cursor-pointer list-none items-center justify-between text-caption font-semibold text-ink select-none">
						<span class="flex flex-wrap items-center gap-xs">
							<ImageIcon size="16" class="text-accent" aria-hidden="true" />
							<span>Media & Screenshots</span>
							<span class="text-ink-tertiary text-xs font-normal">(Optional — Screenshots & Video URL)</span>
						</span>
						<ChevronDown size="16" class="text-ink-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
					</summary>
					<div class="mt-md grid grid-cols-1 gap-md border-t border-hairline-subtle pt-md md:grid-cols-2">
						<BuilderField
							id="project-media-urls-template"
							label="Screenshot URLs"
							className="md:col-span-2"
							hint="One image URL per line. Optional caption syntax: https://example.com/shot.png | Dashboard Preview"
						>
							<textarea
								id="project-media-urls-template"
								name="mediaUrls"
								rows="3"
