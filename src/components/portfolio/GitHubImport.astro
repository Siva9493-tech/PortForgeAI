---
import { Github } from 'lucide-astro';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonPrimary, builderInputClass, builderPanelClass } from './builder-ui';

const visibilityOptions = ['All Repositories', 'Public Only', 'Selected Repositories'];

const connectPanelClass =
	'flex flex-col items-center gap-sm rounded-md border border-hairline bg-surface-2 p-xl text-center';
---

<BuilderSection
	id="github-import"
	headingId="github-import-heading"
	title="GitHub Import"
	description="Connect your GitHub profile to automatically import repositories in the future."
	stepNumber={10}
>
	<form novalidate class="grid grid-cols-1 gap-md md:grid-cols-2">
		<BuilderField id="github-username" label="GitHub Username">
			<input
				id="github-username"
				name="githubUsername"
				type="text"
				placeholder="octocat"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="repository-visibility" label="Repository Visibility">
			<select id="repository-visibility" name="repositoryVisibility" class={builderInputClass}>
				<option value="" disabled selected>
					Select visibility
				</option>
				{visibilityOptions.map((option) => <option value={option}>{option}</option>)}
			</select>
		</BuilderField>
	</form>

	<div class="mx-auto w-full max-w-narrow">
		<div class={connectPanelClass}>
			<span
				class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-surface-2 text-ink-subtle"
				aria-hidden="true"
			>
				<Github size="22" />
			</span>

			<p class="text-card-title text-ink">Connect GitHub</p>
			<p class="max-w-prose text-body text-ink-muted">
				Future versions will securely import your repositories and project information.
			</p>

			<button
				type="button"
				disabled
				class={`${builderButtonPrimary} mt-2`}
			>
				Connect GitHub
			</button>
		</div>
	</div>

	<div class={builderPanelClass}>
		<h3 class="text-card-title text-ink">What will be imported?</h3>
		<ul class="flex list-disc flex-col gap-xs pl-4 text-body-sm text-ink-muted marker:text-ink-subtle">
			<li>Repository names</li>
			<li>Project descriptions</li>
			<li>Technologies used</li>
			<li>README content</li>
			<li>Repository links</li>
		</ul>
	</div>
</BuilderSection>
