---
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import BuilderSuggestions from './BuilderSuggestions.astro';
import ProfilePhotoUpload from './ProfilePhotoUpload.astro';
import { builderGroupLabelClass, builderInputClass, builderTextareaClass } from './builder-ui';
---

<BuilderSection
	id="personal-information"
	headingId="personal-information-heading"
	title="Personal Information"
	description="Provide your basic professional details."
	stepNumber={1}
>
	<form novalidate class="grid grid-cols-1 gap-md md:grid-cols-2">
		<p class="text-caption text-ink-tertiary md:col-span-2">Fields marked * are required.</p>
		<BuilderField id="full-name" label="Full Name" required className="md:col-span-2">
			<input
				id="full-name"
				name="fullName"
				type="text"
				autocomplete="name"
				required
				aria-required="true"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="professional-title" label="Professional Title">
			<input
				id="professional-title"
				name="professionalTitle"
				type="text"
				autocomplete="organization-title"
				placeholder="AI & ML Engineer"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="email" label="Email Address">
			<input
				id="email"
				name="email"
				type="email"
				autocomplete="email"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="phone" label="Phone Number">
			<input
				id="phone"
				name="phone"
				type="tel"
				autocomplete="tel"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="location" label="Location">
			<input
				id="location"
				name="location"
				type="text"
				autocomplete="address-level2"
				placeholder="Guntur, Andhra Pradesh"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField
			id="about"
			label="About Me"
			className="md:col-span-2"
			hint="A short professional introduction for your portfolio summary."
		>
			<textarea
				id="about"
				name="about"
				rows="6"
				placeholder="Write a short professional introduction..."
				class={builderTextareaClass}
			></textarea>
		</BuilderField>
	</form>

	<BuilderSuggestions section="personalInformation" />

	<div
		class="flex flex-col gap-sm"
		role="group"
		aria-labelledby="profile-photo-label"
		data-reveal
	>
		<h3 id="profile-photo-label" class={builderGroupLabelClass}>
			Profile Photo
		</h3>
		<ProfilePhotoUpload />
	</div>
</BuilderSection>
