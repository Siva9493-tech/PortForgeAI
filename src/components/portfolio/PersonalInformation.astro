---
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import ProfilePhotoUpload from './ProfilePhotoUpload.astro';
import { builderInputClass } from './builder-ui';
---

<BuilderSection
	id="personal-information"
	headingId="personal-information-heading"
	title="Personal Information"
	description="Provide your basic professional details."
	stepNumber={1}
>
	<form novalidate class="grid grid-cols-1 gap-md md:grid-cols-2">
		<BuilderField id="full-name" label="Full Name" required className="md:col-span-2">
			<input
				id="full-name"
				name="fullName"
				type="text"
				autocomplete="name"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="professional-title" label="Professional Title">
			<input
				id="professional-title"
				name="professionalTitle"
				type="text"
				autocomplete="organization-title"
				placeholder="AI & ML Engineer"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="email" label="Email Address">
			<input
				id="email"
				name="email"
				type="email"
				autocomplete="email"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="phone" label="Phone Number">
			<input
				id="phone"
				name="phone"
				type="tel"
				autocomplete="tel"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="location" label="Location">
			<input
				id="location"
				name="location"
				type="text"
				autocomplete="address-level2"
				placeholder="Guntur, Andhra Pradesh"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="about" label="About Me" className="md:col-span-2">
			<textarea
				id="about"
				name="about"
				rows="6"
				placeholder="Write a short professional introduction..."
				class={builderInputClass}
			></textarea>
		</BuilderField>
	</form>

	<div
		class="flex flex-col gap-xs border-t border-hairline pt-md"
		role="group"
		aria-labelledby="profile-photo-label"
	>
		<p id="profile-photo-label" class="text-body-sm font-medium text-ink-muted">
			Profile Photo
		</p>
		<ProfilePhotoUpload />
	</div>
</BuilderSection>
