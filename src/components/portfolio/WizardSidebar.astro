---
import { Check } from 'lucide-astro';
import { WIZARD_STEPS, getSectionStatus, isSectionCompleted, wizardStore } from '../../lib/portfolio';
import { SECTION_META } from './section-meta';
import type { SectionStatus, StepId } from '../../lib/portfolio';

const state = wizardStore.getState();

interface StepDisplay {
	stepId: StepId;
	number: number;
	title: string;
	shortLabel: string;
	icon: (typeof SECTION_META)[number]['icon'];
	isActive: boolean;
	isCompleted: boolean;
	isVisited: boolean;
	status: SectionStatus;
}

const stepsWithState: StepDisplay[] = SECTION_META.map((meta) => {
	const isActive = state.currentStep === meta.stepId;
	const isCompleted = isSectionCompleted(state.data, meta.stepId);
	const isVisited = state.visitedSteps.includes(meta.stepId);
	const status = getSectionStatus(state.data, state.visitedSteps, meta.stepId);
	return {
		stepId: meta.stepId,
		number: meta.number,
		title: meta.title,
		shortLabel: meta.shortLabel,
		icon: meta.icon,
		isActive,
		isCompleted,
		isVisited,
		status,
	};
});

function itemClasses({ isActive, isCompleted, isVisited }: StepDisplay): string {
	const base =
		'flex w-auto items-center gap-sm rounded-md px-sm py-sm text-left transition-colors duration-200 lg:w-full';
	if (isActive) return `${base} bg-surface-2 text-ink font-medium ring-1 ring-inset ring-primary`;
	if (isCompleted || isVisited) return `${base} text-ink-muted hover:bg-surface-2/60`;
	return `${base} text-ink-subtle hover:bg-surface-2/60`;
}

	function badgeClasses(isActive: boolean, isCompleted: boolean): string {
		const base =
			'hidden h-6 w-6 shrink-0 items-center justify-center rounded-md text-caption font-medium transition-colors duration-200 lg:flex';
		if (isActive) return `${base} bg-primary text-on-primary`;
		if (isCompleted) return `${base} bg-surface-2 text-semantic-success`;
		return `${base} bg-surface-1 text-ink-tertiary`;
	}

	function stateLabel(item: StepDisplay): string {
		if (item.isActive) return 'current section';
		if (item.status === 'complete') return 'complete';
		return item.status === 'in-progress' ? 'in progress' : 'not started';
	}
---

<aside
	id="wizard-sidebar"
	aria-label="Portfolio Builder Steps"
	class="card edge-highlight shadow-sm min-w-0 self-start p-md lg:sticky lg:top-0"
>
	<div class="mb-md flex items-center justify-between gap-sm">
		<h2 class="text-card-title text-ink">Portfolio Builder</h2>
		<span class="rounded-pill border border-hairline bg-surface-2 px-xs py-xxs text-caption text-ink-tertiary">
			<span class="sr-only">Sections complete:</span>
			<span data-steps-complete>{stepsWithState.filter((s) => s.isCompleted).length}</span> / {WIZARD_STEPS.length}
		</span>
	</div>

	<nav aria-label="Builder steps">
		<ol class="relative flex gap-xs overflow-x-auto pb-xs lg:flex-col lg:gap-1 lg:overflow-visible lg:pb-0">
			{
				stepsWithState.map((item) => (
					<li class="shrink-0 lg:w-full lg:shrink">
						<button
							type="button"
							data-step-id={item.stepId}
							data-step-title={item.title}
							data-state={
								item.isActive
									? 'active'
									: item.isCompleted
										? 'completed'
										: item.isVisited
											? 'visited'
											: 'upcoming'
							}
							aria-current={item.isActive ? 'step' : undefined}
							aria-label={`${item.title}, ${stateLabel(item)}`}
							class={itemClasses(item)}
						>
							<span
								class={badgeClasses(item.isActive, item.isCompleted)}
								data-step-number={item.number}
								aria-hidden="true"
							>
								{item.isCompleted && !item.isActive ? <Check size="14" /> : item.number}
							</span>
							<item.icon size="16" class="shrink-0" aria-hidden="true" />
							<span class="hidden truncate text-body-sm lg:block">{item.title}</span>
							<span class="truncate text-body-sm lg:hidden">{item.shortLabel}</span>
						</button>
					</li>
				))
			}
		</ol>
	</nav>
</aside>

<script>
	import { getSectionStatus, isSectionCompleted, wizardStore } from '../../lib/portfolio';
	import type { SectionStatus, StepId } from '../../lib/portfolio';

	const sidebar = document.getElementById('wizard-sidebar');

	if (sidebar) {
		const buttons = Array.from(
			sidebar.querySelectorAll<HTMLButtonElement>('[data-step-id]')
		);
		const list = sidebar.querySelector('ol');
		const stepsComplete = sidebar.querySelector<HTMLElement>('[data-steps-complete]');

		const stateLabel = (info: { isActive: boolean; status: SectionStatus }): string => {
			if (info.isActive) return 'current section';
			if (info.status === 'complete') return 'complete';
			return info.status === 'in-progress' ? 'in progress' : 'not started';
		};

		const stepState = (button: HTMLButtonElement) => {
			const stepId = button.dataset.stepId as StepId | undefined;
			if (!stepId) return null;
			const state = wizardStore.getState();
			return {
				stepId,
				title: button.dataset.stepTitle ?? stepId,
				isActive: state.currentStep === stepId,
				isCompleted: isSectionCompleted(state.data, stepId),
				isVisited: state.visitedSteps.includes(stepId),
				status: getSectionStatus(state.data, state.visitedSteps, stepId),
			};
		};

		const createCheckIcon = () => {
			const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
			svg.setAttribute('data-check-icon', '');
			svg.setAttribute('viewBox', '0 0 24 24');
			svg.setAttribute('width', '14');
			svg.setAttribute('height', '14');
			svg.setAttribute('fill', 'none');
			svg.setAttribute('stroke', 'currentColor');
			svg.setAttribute('stroke-width', '2');
			svg.setAttribute('stroke-linecap', 'round');
			svg.setAttribute('stroke-linejoin', 'round');
			svg.setAttribute('aria-hidden', 'true');
			svg.classList.add('animate-pop-in');
			svg.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
			return svg;
		};

		const applyState = () => {
			let completeCount = 0;

			for (const button of buttons) {
				const info = stepState(button);
				if (!info) continue;

				if (info.isCompleted) completeCount += 1;

				button.classList.toggle('bg-surface-2', info.isActive);
				button.classList.toggle('text-ink', info.isActive);
				button.classList.toggle('font-medium', info.isActive);
				button.classList.toggle('ring-1', info.isActive);
				button.classList.toggle('ring-inset', info.isActive);
				button.classList.toggle('ring-primary', info.isActive);
				button.classList.toggle(
					'text-ink-muted',
					!info.isActive && (info.isVisited || info.isCompleted)
				);
				button.classList.toggle(
					'text-ink-subtle',
					!info.isActive && !info.isVisited && !info.isCompleted
				);

				const badge = button.querySelector<HTMLSpanElement>('[data-step-number]');
				if (badge) {
					badge.classList.toggle('bg-primary', info.isActive);
					badge.classList.toggle('text-on-primary', info.isActive);
					badge.classList.toggle('bg-surface-2', !info.isActive && info.isCompleted);
					badge.classList.toggle('text-semantic-success', !info.isActive && info.isCompleted);
					badge.classList.toggle('bg-surface-1', !info.isActive && !info.isCompleted);
					badge.classList.toggle('text-ink-tertiary', !info.isActive && !info.isCompleted);

					const showCheck = !info.isActive && info.isCompleted;
					const icon = badge.querySelector('[data-check-icon]');
					if (showCheck && !icon) {
						badge.replaceChildren(createCheckIcon());
					} else if (!showCheck && icon) {
						badge.textContent = badge.dataset.stepNumber ?? '';
					}
				}

				if (info.isActive) {
					button.setAttribute('aria-current', 'step');
				} else {
					button.removeAttribute('aria-current');
				}

				button.setAttribute('aria-label', `${info.title}, ${stateLabel(info)}`);

				button.dataset.state = info.isActive
					? 'active'
					: info.isCompleted
						? 'completed'
						: info.isVisited
							? 'visited'
							: 'upcoming';
			}

			if (stepsComplete) stepsComplete.textContent = String(completeCount);

			if (list && list.scrollWidth > list.clientWidth) {
				const active = buttons.find((button) => button.dataset.state === 'active');
				if (active) {
					const target = active.offsetLeft - (list.clientWidth - active.clientWidth) / 2;
					list.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
				}
			}
		};

		for (const button of buttons) {
			button.addEventListener('click', () => {
				const stepId = button.dataset.stepId as StepId | undefined;
				if (stepId) wizardStore.goToStep(stepId);
			});
		}

		wizardStore.subscribe(applyState);
		applyState();
	}
</script>
