---
interface Step {
	number: number;
	title: string;
}

const steps: Step[] = [
	{ number: 1, title: 'Personal Information' },
	{ number: 2, title: 'Education' },
	{ number: 3, title: 'Experience' },
	{ number: 4, title: 'Projects' },
	{ number: 5, title: 'Skills' },
	{ number: 6, title: 'Certifications' },
	{ number: 7, title: 'Achievements' },
	{ number: 8, title: 'Social Links' },
	{ number: 9, title: 'Resume Upload' },
	{ number: 10, title: 'GitHub Import' },
	{ number: 11, title: 'LinkedIn Import' },
];

const firstStepNumber = 1;
---

<aside
	id="wizard-sidebar"
	aria-label="Portfolio Builder Steps"
	class="card self-start p-md lg:sticky lg:top-0"
>
	<div class="mb-md flex items-center justify-between gap-sm">
		<h2 class="text-body font-semibold text-ink">Portfolio Builder</h2>
		<span class="text-caption text-ink-tertiary">{steps.length} Steps</span>
	</div>

	<nav aria-label="Builder steps">
		<ol class="flex flex-col gap-1">
			{
				steps.map((step) => {
					const isActive = step.number === firstStepNumber;
					return (
						<li>
							<div
								class:list={[
									'flex items-center gap-sm rounded-md px-sm py-sm',
									isActive
										? 'bg-surface-2 text-ink'
										: 'text-ink-subtle',
								]}
								aria-current={isActive ? 'step' : undefined}
							>
								<span
									class:list={[
										'flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-caption font-medium',
										isActive
											? 'bg-primary text-on-primary'
											: 'bg-surface-1 text-ink-tertiary',
									]}
									aria-hidden="true"
								>
									{step.number}
								</span>
								<span class="truncate text-body-sm">{step.title}</span>
							</div>
						</li>
					);
				})
			}
		</ol>
	</nav>
</aside>