---
import { Plus } from 'lucide-astro';
import BuilderField from './BuilderField.astro';
import BuilderSection from './BuilderSection.astro';
import { builderButtonSecondary, builderInputClass } from './builder-ui';
---

<BuilderSection
	id="skills"
	headingId="skills-heading"
	title="Skills"
	description="Highlight your technical and professional expertise."
	stepNumber={5}
>
	<form novalidate class="grid grid-cols-1 gap-md md:grid-cols-2">
		<BuilderField id="programming-languages" label="Programming Languages">
			<input
				id="programming-languages"
				name="programmingLanguages"
				type="text"
				placeholder="Python, Java, C++, JavaScript"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="frameworks" label="Frameworks & Libraries">
			<input
				id="frameworks"
				name="frameworks"
				type="text"
				placeholder="React, Astro, Tailwind CSS, TensorFlow"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="databases" label="Databases">
			<input
				id="databases"
				name="databases"
				type="text"
				placeholder="MySQL, PostgreSQL, MongoDB"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="dev-tools" label="Developer Tools">
			<input
				id="dev-tools"
				name="devTools"
				type="text"
				placeholder="Git, GitHub, VS Code, Docker"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="cloud-platforms" label="Cloud & Platforms" className="md:col-span-2">
			<input
				id="cloud-platforms"
				name="cloudPlatforms"
				type="text"
				placeholder="Vercel, Google Cloud, Firebase"
				class={builderInputClass}
			/>
		</BuilderField>

		<BuilderField id="soft-skills" label="Soft Skills" className="md:col-span-2">
			<textarea
				id="soft-skills"
				name="softSkills"
				rows="4"
				placeholder="Leadership, Communication, Teamwork, Problem Solving..."
				class={builderInputClass}
			></textarea>
		</BuilderField>

		<BuilderField id="additional-skills" label="Additional Skills" className="md:col-span-2">
			<textarea
				id="additional-skills"
				name="additionalSkills"
				rows="4"
				placeholder="Mention any additional skills or technologies..."
				class={builderInputClass}
			></textarea>
		</BuilderField>
	</form>

	<button type="button" disabled aria-disabled="true" slot="actions" class={builderButtonSecondary}>
		<Plus size="16" aria-hidden="true" />
		Add More Skills
	</button>
</BuilderSection>
