# Public Supabase configuration. These are exposed to the browser bundle
# (\PUBLIC_*\ prefix) and are required for both build-time prerender of
# marketing pages and request-time SSR for authenticated and portfolio routes.
# Set these in the Vercel project environment (Production, Preview, Development).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-Side Developer Notification Configuration (Optional)
# Set in Vercel project environment (Production, Preview, Development).
# Developer notification recipient (defaults to mamidalasivabalaji@gmail.com if unset)
DEVELOPER_NOTIFICATION_EMAIL=mamidalasivabalaji@gmail.com

# Email provider: Resend (Recommended: https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=PortForge AI <onboarding@resend.dev>

# Alternative Email provider: SendGrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@portforge.ai

# Alternative: Webhook (Slack / Discord / Zapier)
# NOTIFICATION_WEBHOOK_URL=

